---
import Icon from './Icon.astro';
const { email = '', bookingUrl = '', services = [], pricing = [], brand = 'WebDECOR', showContactLinks = true } = Astro.props;
---
<div class="ag-inquiry project-inquiry">
  {showContactLinks && (email || bookingUrl) && <div class="ag-contact-links">{email && <a href={`mailto:${email}`} class="ag-email">{email}<span aria-hidden="true"><Icon name="arrow-up-right" /></span></a>}{bookingUrl && <a href={bookingUrl} target="_blank" rel="noopener noreferrer">Book an introduction <Icon name="arrow-up-right" /></a>}</div>}
  <form class="ag-inquiry-form project-brief-form" data-email={email} data-brand={brand}>
    <fieldset class="ag-form-fieldset" disabled>
      <legend class="ag-form-legend">Project details</legend>
      <div class="ag-form-rail"><span>INPUT / YOUR PROJECT</span><span aria-hidden="true"><Icon name="plus" /></span></div>
      <div class="wd-form-divider"><span>01</span> IDENTITY / YOUR DETAILS</div>
      <div class="ag-form-row"><label>Your name <span class="ag-optional">required</span><input name="name" autocomplete="name" required maxlength="120" placeholder="Name" /></label><label>Company / organisation <span class="ag-optional">optional</span><input name="company" autocomplete="organization" maxlength="160" placeholder="Brand or business" /></label></div>
      <div class="ag-form-row"><label>Email <span class="ag-optional">optional</span><input name="email" type="email" autocomplete="email" maxlength="200" placeholder="you@yourcompany.com" /></label><label>What do you need?<select name="service">{services.map((service: any) => <option value={service.id}>{service.name}</option>)}<option value="explore">Help defining the project</option></select></label></div>
      <div class="wd-form-divider"><span>02</span> AMBITION / PROJECT SCOPE</div>
      <label>Package<select name="plan"><option value="explore">Still exploring</option>{pricing.map((plan: any) => <option value={plan.id}>{plan.name}{plan.id !== 'custom' ? ` — ${plan.price}` : ''}</option>)}</select></label>
      <label>Tell us about the project <span class="ag-optional">required</span><textarea name="idea" required rows="5" maxlength="4000" placeholder="Your starting point, your audience, and what you want the website to do."></textarea></label>
      <div class="wd-form-divider"><span>03</span> NEXT CHAPTER / TIMING</div>
      <div class="ag-form-row"><label>Ideal launch date <span class="ag-optional">optional</span><input name="timeline" maxlength="100" placeholder="A date, a season, or still exploring" /></label><label>Budget in mind <span class="ag-optional">optional</span><input name="budget" maxlength="100" placeholder="A range is helpful" /></label></div>
      <div class="ag-form-actions"><button type="submit">{email ? 'OPEN EMAIL DRAFT' : 'DOWNLOAD YOUR BRIEF'}<span aria-hidden="true"><Icon name={email ? 'arrow-up-right' : 'arrow-down'} /></span></button>{email && <button class="ag-form-secondary" type="button" data-download-brief>DOWNLOAD A COPY <span aria-hidden="true"><Icon name="arrow-down" /></span></button>}</div>
      <p class="ag-form-status project-form-status" role="status">{email ? 'Opens your email app. Review the draft and send it there. Nothing is sent through this website.' : 'Your brief downloads to your device. Nothing is submitted or sent.'}</p>
    </fieldset>
    <noscript><p>Enable JavaScript to prepare a brief.{email && <> You can also <a href={`mailto:${email}`}>email {brand} directly</a>.</>}</p></noscript>
  </form>
</div>
<script>import '../scripts/agency-inquiry';</script>
<style>
  .ag-form-legend {position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
  .project-brief-form label,.project-brief-form .ag-optional,.project-brief-form .ag-form-rail,.project-brief-form .wd-form-divider,.project-brief-form .ag-form-actions button,.project-brief-form .ag-form-status {font-size:12px}
  .project-brief-form .ag-form-status {line-height:1.6}
  .project-brief-form input,.project-brief-form select,.project-brief-form textarea,.project-brief-form button {min-height:44px}
  .ag-contact-links a {display:flex;align-items:center;min-height:44px}
  .project-brief-form .ag-form-actions {flex-wrap:wrap}
  .project-brief-form .ag-form-actions .ag-form-secondary {background:transparent;color:var(--cy-ink,currentColor);border-color:var(--cy-rule,currentColor)}
  .project-brief-form .ag-form-actions .ag-form-secondary>span {color:inherit}
  .project-brief-form .ag-form-actions .ag-form-secondary:hover {background:var(--cy-ink,#1c1c1b);color:var(--cy-paper,#f2f2ec)}
  .project-brief-form fieldset:disabled button {cursor:wait}
  .project-brief-form noscript p {font-size:14px;line-height:1.6}
</style>
