---
import Icon from '../Icon.astro';
const { slug, large = false } = Astro.props;
---
<div class:list={['wd-study-preview', 'wd-preview-'+slug, 'wd-preview-cybercore', { 'wd-preview-large':large }]} data-study-preview data-study-tone="cybercore" aria-hidden="true">
  {slug==='collage'&&<><div class="wd-preview-top"><span>wd!</span><span>INDEPENDENT & IMAGINATIVE</span></div><div class="wd-preview-paper"></div><figure><div class="wd-preview-picture"><img src="/images/collage-playground.webp" alt="" width="1536" height="1024" loading="lazy"/></div><figcaption>a little weird. a lot of heart.</figcaption></figure><b>Serious ideas.<br/><em>Wild websites.</em></b><span class="wd-preview-tape"></span><span class="wd-preview-sticker">PLAY<br/>MORE!</span><span class="wd-preview-hand">less ordinary.</span></>}
  {slug==='swiss'&&<><div class="wd-preview-top"><span>WebDECOR</span><span>DESIGN PRACTICE / 02</span></div><span class="wd-swiss-index">02—</span><b>Clarity.<br/>Character.<br/><em>Conviction.</em></b><div class="wd-preview-swiss-mark"><svg viewBox="0 0 100 100" fill="none"><path d="M0 50h100M50 0v100" stroke="currentColor" stroke-width="16"/></svg></div><span class="wd-preview-bottom">INDEPENDENT BY DESIGN.<span>W/D <Icon name="arrow-up-right"/></span></span></>}
  {slug==='hackerlair'&&<>
    <div class="wd-preview-tui-chrome"><span>[wd®] HACKERLAIR</span><span>workspace / UTF-8</span></div>
    <div class="wd-preview-tui-workspace">
      <div class="wd-preview-tui-explorer"><div class="wd-preview-tui-label">explorer</div><span class="wd-preview-tui-root">~/webdecor</span><span class="is-selected">README.md</span><span>services.md</span><span>studies/</span><span>pricing.cfg</span><span>studio.md</span><span>new-project.md</span><small>independent<br/>design practice</small></div>
      <div class="wd-preview-tui-document"><div class="wd-preview-tui-label">README.md</div><div class="wd-preview-tui-copy"><span>name: WebDECOR<br/>intent: websites with character</span><b># Human input.<br/>Strange output_</b><p>We turn a point of view into a website people want to explore.</p><div class="wd-preview-tui-links"><span>## open a file</span><span>01 services.md <Icon name="arrow-right"/></span><span>02 studies/ <Icon name="arrow-right"/></span><span>03 new-project.md <Icon name="arrow-right"/></span></div></div><div class="wd-preview-tui-document-foot">read mode / human authored</div></div>
      <div class="wd-preview-tui-inspector"><div class="wd-preview-tui-label">image → glyphs</div><pre class="wd-preview-tui-glyphs">{`
