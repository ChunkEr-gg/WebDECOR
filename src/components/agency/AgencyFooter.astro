---
import Icon from '../Icon.astro';
import CyberAsterisk from './CyberAsterisk.astro';
import CyberWordmark from '../CyberWordmark.astro';
import AgencySocialIcon from './AgencySocialIcon.astro';
import {agency} from '../../data/agency';
import '../../styles/agency-footer-socials.css';
// Profiles without a valid URL are not shown; the section appears once at least one is supplied.
const socialProfiles = agency.socials.flatMap(social => {
  try {
    const candidate = new URL(social.url.trim());
    if (candidate.protocol === 'https:' || candidate.protocol === 'http:') return [{...social, url: candidate.href}];
  } catch { /* Empty or invalid URL. */ }
  return [];
});
---
<footer class="cy-footer ag-footer">
  <div class="ag-footer-top"><p>WEBSITES WITH<br/>CHARACTER.</p><nav aria-label="Footer navigation"><a href="/services/">Services <Icon name="arrow-up-right"/></a><a href="/services/#pricing">Pricing <Icon name="arrow-up-right"/></a><a href="/explore/">Design studies <Icon name="arrow-up-right"/></a><a href="/studio/">The studio <Icon name="arrow-up-right"/></a><a href="/start/">Start a project <Icon name="arrow-up-right"/></a></nav><span class="ag-footer-mark" aria-hidden="true"><CyberAsterisk/></span></div>
  <div class="ag-footer-contact"><a href={`mailto:${agency.email}`}>{agency.email} <Icon name="arrow-up-right"/></a></div>
  {socialProfiles.length > 0 && <section class="ag-footer-socials" aria-label="Social profiles">
    <div class="ag-social-heading"><span class="ag-social-kicker">SOCIAL / STUDIO SIGNALS</span><h2>Elsewhere.</h2></div>
    <ul class="ag-social-list">
      {socialProfiles.map(social => <li><a class="ag-social-item" href={social.url} target="_blank" rel="noopener noreferrer"><AgencySocialIcon name={social.id}/><span class="ag-social-copy"><strong>{social.name}</strong><small>{social.purpose}</small></span><Icon name="arrow-up-right"/><span class="ag-social-new-tab">Opens in a new tab</span></a></li>)}
    </ul>
  </section>}
  <a href="/" class="cy-footer-wordmark" aria-label="WebDECOR home"><CyberWordmark instance="footer"/></a><div class="cy-footer-details"><span>WEBDECOR / INDEPENDENT WEB DESIGN<br/>© {new Date().getFullYear()}</span><a href="/explore/">DESIGN ARCHIVE <Icon name="arrow-up-right"/></a><a href="#top">RETURN TO TOP <Icon name="arrow-up"/></a></div>
</footer>
<style>
.ag-footer-contact{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;padding:20px;border-inline:1px solid #ffffff30;border-block:1px solid #ffffff30;font:12px/1.6 'JetBrains Mono Variable',monospace}.ag-footer-contact a{display:flex;align-items:center;gap:16px;min-height:44px;overflow-wrap:anywhere}.ag-footer-contact svg{width:18px;height:18px}
</style>
