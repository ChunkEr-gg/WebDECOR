---
import Icon from './Icon.astro';
---
<dialog id="concept-brief" class="concept-brief" aria-labelledby="concept-brief-title"><button class="brief-close" aria-label="Close project brief"><Icon name="close"/></button><span class="brief-eyebrow">WEBDECOR / YOUR NEXT CHAPTER</span><h2 id="concept-brief-title">Every good project<br/>starts with a good brief.</h2><p>A few thoughts now. A clearer direction next. Create a brief you can keep and share with your team.</p><form class="concept-brief-form"><div class="brief-row"><label>Your name<input name="name" autocomplete="name" required maxlength="120" placeholder="Alex Taylor"/></label><label>Your brand<input name="brand" autocomplete="organization" required maxlength="150" placeholder="Your next big thing"/></label></div><label>What do you have in mind?<textarea name="idea" required rows="4" maxlength="4000" placeholder="Tell us about the brand, the audience, and what you'd like to change."></textarea></label><label>The starting point<select name="service"><option>Website design & development</option><option>Website redesign</option><option>Brand & website</option><option>Let's find out together</option></select></label><button type="submit" class="brief-submit">Download project brief</button><p class="brief-status" role="status">Saved on your device. No message is sent.</p></form></dialog>
<style>
 .concept-brief{width:min(650px,calc(100% - 30px));max-height:90dvh;overflow:auto;border:0;background:#fafaf7;color:#171717;padding:42px;font:400 16px/1.5 'DM Sans Variable',sans-serif;box-shadow:0 30px 100px #0007;text-align:left}.concept-brief::backdrop{background:#101017c4;backdrop-filter:blur(8px)}.brief-close{position:absolute;right:16px;top:16px;background:transparent;color:#171717;border:1px solid #aaa;width:38px;height:38px;border-radius:50%;font-size:28px;line-height:1;cursor:pointer}.brief-eyebrow{font-size:11px;font-weight:700;letter-spacing:1.2px;display:block;padding-right:30px}.concept-brief h2{font:600 36px/1.1 'Space Grotesk Variable',sans-serif;letter-spacing:-1.5px;margin:25px 0 18px}.concept-brief>p{margin:0;color:#5d5d5d}.concept-brief-form{margin-top:26px}.concept-brief-form label{display:flex;flex-direction:column;gap:8px;margin-bottom:20px;font-size:14px;font-weight:600}.brief-row{display:grid;grid-template-columns:1fr 1fr;gap:18px}.concept-brief-form input,.concept-brief-form textarea,.concept-brief-form select{font:400 16px/1.5 'DM Sans Variable',sans-serif;width:100%;padding:12px;color:#171717;background:#fff;border:1px solid #999;border-radius:0}.concept-brief-form textarea{resize:vertical;min-height:120px}.brief-submit{width:100%;padding:16px;font:600 15px 'Space Grotesk Variable',sans-serif;background:#171717;color:white;border:0;cursor:pointer}.brief-submit:hover{background:#2449ee}.brief-status{font-size:12px;line-height:1.5;color:#606060;margin:14px 0 0}.concept-brief :focus-visible{outline:3px solid #2449ee;outline-offset:4px}@media(max-width:600px){.concept-brief{padding:38px 23px}.concept-brief h2{font-size:30px}.brief-row{grid-template-columns:1fr;gap:0}}
</style>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('#concept-brief');let opener:HTMLElement|null=null;
 document.querySelectorAll<HTMLElement>('[data-project-brief]').forEach(button=>button.addEventListener('click',()=>{opener=button;document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach(d=>d.close());dialog?.showModal();}));
 dialog?.querySelector('.brief-close')?.addEventListener('click',()=>dialog.close());
 dialog?.addEventListener('close',()=>opener?.focus());
 dialog?.addEventListener('click',event=>{if(event.target!==dialog)return;const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();});
 document.querySelector<HTMLFormElement>('.concept-brief-form')?.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const d=new FormData(form);const text=`WEBDECOR — PROJECT BRIEF\n\nName: ${d.get('name')}\nBrand: ${d.get('brand')}\nStarting point: ${d.get('service')}\n\nYour idea\n${d.get('idea')}\n\nNext steps\nGather your brand assets, define your audience, and set your ideal launch date.\n`;const url=URL.createObjectURL(new Blob([text],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='webdecor-project-brief.txt';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);const s=form.querySelector('.brief-status');if(s)s.textContent='Your brief is ready. A good place to start your next conversation.';});
</script>
