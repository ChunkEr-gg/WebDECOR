---
import {studies} from '../../data/agency';
---
<div class="u-projects u-agency-studies">{studies.map((study,i)=><a class={`u-project ${i?'u-project-two':'u-project-one'}`} href={`/underground/work/${study.slug}/`}><div class="u-project-art"><img src={study.image} alt={study.alt} width={study.width} height={study.height} loading="lazy"/><span class="u-project-title">{study.name}</span><span class="u-project-open">OPEN STUDY +</span></div><span class="u-meta">{study.category} / SELF-INITIATED CONCEPT</span><h3>{study.headline}</h3><p>{study.summary}</p></a>)}</div>