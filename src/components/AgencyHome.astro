---
import Icon from './Icon.astro';
import CyberAsterisk from './agency/CyberAsterisk.astro';
import CyberQuestionMark from './agency/CyberQuestionMark.astro';
import CyberCreativeMark from './agency/CyberCreativeMark.astro';
import AgencyProcess from './agency/AgencyProcess.astro';
import AgencyLayout from '../layouts/AgencyLayout.astro';
import CyberWordmark from './CyberWordmark.astro';
import CyberProjectWordmark from './CyberProjectWordmark.astro';
import AgencyInvitation from './agency/AgencyInvitation.astro';
import AgencyPricing from './agency/AgencyPricing.astro';
import { agency } from '../data/agency';
import ResponsiveStudy from './agency/ResponsiveStudy.astro';
import DesignArchive from './agency/DesignArchive.astro';
import { studyImage } from '../data/design-studies';
const { world = 'cybercore', study, title } = Astro.props;
const asset = (src:string, alt:string) => studyImage(src,alt,world);
---
<AgencyLayout world={world} study={study} title={title}>
<section class="cy-hero" data-layout-key="hero" aria-labelledby="cy-title">
<figure class="wd-hacker-art"><div class="wd-terminal-rail"><span>webdecor@studio:~</span><span>image / 001</span></div><div class="wd-hacker-image"><img src="/images/crt-eye.webp" alt="A human eye dissolving into a rippling field of phosphor-green ASCII characters" width="1280" height="1280"/></div><figcaption><span>HUMAN INPUT / STRANGE OUTPUT</span><span>UTF-8</span></figcaption></figure>
<div class="wd-collage-art" aria-hidden="true"><div class="wd-paper-back"></div><figure><img src="/images/collage-playground.webp" alt="" width="1536" height="1024"/><figcaption>a little weird. a lot of heart.</figcaption></figure><span class="wd-paper-tape"></span><span class="wd-collage-sticker">PLAY<br/>MORE!<small>MAKE SOMETHING STRANGE.</small></span><span class="wd-collage-scrawl">less ordinary.<br/>more you.</span><span class="wd-collage-star"><CyberAsterisk/></span></div>
<div class="wd-swiss-art" aria-hidden="true"><b>W/D</b><span>INDEPENDENT BY DESIGN.<br/>CLARITY / CHARACTER / CONVICTION</span></div>
<div class="cy-archive-row"><div class="cy-archive-image"><img {...asset("/images/crt-foil.webp", "")} aria-hidden="true"/><span>01 / MATERIAL STUDY</span></div><div class="cy-archive-data"><span>INDEPENDENT WEB DESIGN</span><span>EXPRESSION THROUGH TECHNOLOGY</span></div><div class="cy-archive-stamp" aria-hidden="true"><svg viewBox="0 0 70 70" fill="none" stroke="currentColor"><rect x="8" y="8" width="43" height="43" rx="9"/><rect x="20" y="20" width="43" height="43" rx="9"/><circle cx="35" cy="35" r="10"/><path d="M35 0v19M35 51v19M0 35h19M51 35h19"/></svg></div><div class="cy-archive-image cy-eye"><img src="/images/crt-eye.webp" alt="" aria-hidden="true"/><span>02 / HUMAN OBSERVATION</span></div></div>
<div class="cy-title-cell"><div class="cy-title-meta"><span><b aria-hidden="true"><CyberAsterisk/></b> HUMAN IDEAS / DIGITAL EXPRESSION</span><span class="cy-title-coordinate">FORM — 004 <b aria-hidden="true"><CyberAsterisk/></b></span></div><h1 id="cy-title" aria-label="WebDECOR">{world==='cybercore'?<button class="wd-hero-logo" type="button" data-activation-toggle data-activation-logo aria-pressed="false" aria-label="WebDECOR — switch to Cybercore"><CyberWordmark/><span class="cy-sr-only">WebDECOR</span></button>:<><CyberWordmark/><span class="cy-sr-only">WebDECOR</span></>}</h1><div class="cy-wordmark-foot"><span>WEBSITES WITH CHARACTER.</span><span>INDEPENDENT BY DESIGN.</span></div></div>
<div class="cy-hero-lower"><div class="cy-manifesto"><h2 class="wd-default-tagline">Websites with character.<br/>Built with purpose.</h2><h2 class="wd-collage-tagline">Serious ideas.<br/><em>Wild websites.</em></h2><h2 class="wd-swiss-tagline">Clarity.<br/>Character.<br/><em>Conviction.</em></h2><p>Web design, art direction, and development.<br/>For brands with a point of view.</p><a href="/explore/">EXPLORE THE STUDIES <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></div><div class="cy-system-cell" aria-hidden="true"><span>CREATIVE INPUT</span><div><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div><span>DISTINCTIVE OUTPUT <Icon name="arrow-right"/></span></div><div class="cy-human-cell"><div class="cy-red-panel"><CyberCreativeMark/></div><span>HUMAN / EXPRESSION / INTEGRATION</span></div></div>
<div class="cy-bottom-grid"><div class="cy-calibration" aria-hidden="true"><span><Icon name="plus"/></span><span><Icon name="plus"/></span><small>ALIGNMENT / INTENTION</small></div><div class="cy-field-note"><span class="cy-label">STUDIO NOTE 001</span><p>A website should feel like<br/>someone made a choice.</p></div><div class="cy-organic"><img src="/images/crt-moon.webp" alt="Close detail of a monochrome lunar print"/><span>ARCHIVE / OTHER WORLDS</span></div><a class="cy-next" href="/explore/"><span>DESIGN<br/>STUDIES</span><b aria-hidden="true"><Icon name="arrow-down"/></b></a></div>
</section>
<section data-layout-key="services" id="services" class="ag-services" aria-labelledby="services-title"><div class="ag-section-heading"><span class="cy-label">01 / CAPABILITIES</span><h2 id="services-title">The idea.<br/>The design.<br/><em>The whole website.</em></h2><p>Start from scratch, rethink what exists, or bring a new direction to life. The right combination begins with your project.</p></div><div class="ag-service-console"><div class="ag-service-tabs" role="tablist" aria-label="Explore services" aria-orientation="vertical">{agency.services.map((service,i)=><button id={`tab-${service.id}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`panel-${service.id}`} tabindex={i===0?0:-1}><span>{service.number}</span><strong>{service.name}</strong><b aria-hidden="true"><Icon name="arrow-up-right"/></b></button>)}</div><div class="ag-service-panels">{agency.services.map((service,i)=><div role="tabpanel" id={`panel-${service.id}`} aria-labelledby={`tab-${service.id}`} hidden={i!==0} tabindex="0"><div class="ag-panel-rail" aria-hidden="true"><span>WD / {service.number} / {service.id.toUpperCase()}</span><span><Icon name="plus"/></span></div><h3>{service.line}</h3><p>{service.description}</p><ul>{service.deliverables.map(item=><li>{item}</li>)}</ul><a href={`/services/#${service.id}`} class="cy-text-link">EXPLORE THE SERVICE <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></div>)}</div></div></section>
<AgencyPricing/>
<section data-layout-key="work" id="work" class="cy-work" aria-labelledby="work-title"><div class="cy-section-heading"><span class="cy-label">02 / DESIGN STUDIES</span><h2 id="work-title">Character,<br/><em>in context.</em></h2><span class="cy-label">SELF-INITIATED CONCEPTS<br/>FASHION / SPACE / CULTURE</span></div><p class="ag-study-note">Explorations in identity and interface. These are design concepts, not client commissions.</p><div class="cy-work-rail" aria-hidden="true"><span>OBJECT / IMAGE / INTERFACE</span><span class="cy-barcode"></span><span>SELECT A STUDY <Icon name="arrow-down-right"/></span></div><div class="cy-project-grid" data-study-gallery><a class="cy-project" href="/work/forme/" aria-label="Explore FORME fashion concept"><div class="cy-project-meta"><span>01 / FORME</span><span>CONCEPT / FASHION</span></div><div class="cy-project-image"><img {...asset("/images/cybercore-forme-scan.webp", "A black technical shoulder bag with halftone scan textures, contour lines, and a red registration mark")} loading="lazy" width="1402" height="1122"/><span aria-hidden="true"><Icon name="arrow-up-right"/></span><div class="cy-project-identity"><CyberProjectWordmark project="forme"/><span class="cy-project-index" aria-hidden="true">F / 01<br/>MATERIAL SCAN</span><span class="cy-sr-only">FORME</span></div></div><div class="cy-project-caption"><h3>Desire, reframed.</h3><span>ART DIRECTION / DIGITAL IDENTITY</span></div></a><a class="cy-project" href="/work/object/" aria-label="Explore OBJECT / ROOM interiors concept"><div class="cy-project-meta"><span>02 / OBJECT — ROOM</span><span>CONCEPT / INTERIORS</span></div><div class="cy-project-image"><img {...asset("/images/cybercore-object-wireframe.webp", "A sculptural metal chair dissolving into a wireframe in a stark architectural space")} loading="lazy" width="1254" height="1254"/><span aria-hidden="true"><Icon name="arrow-up-right"/></span><div class="cy-project-identity"><CyberProjectWordmark project="object"/><span class="cy-project-index" aria-hidden="true">O / 02<br/>SPATIAL STUDY</span><span class="cy-sr-only">OBJECT / ROOM</span></div></div><div class="cy-project-caption"><h3>A different perspective.</h3><span>WEB DESIGN / DEVELOPMENT</span></div></a></div></section>
{!study&&<DesignArchive/>}
<section data-layout-key="studio" id="studio" class="cy-studio" aria-labelledby="studio-title"><div class="cy-studio-label"><span class="cy-label">03 / THE AGENCY</span><ResponsiveStudy id="home-proof"/><span class="cy-label">ARTISTIC INSTINCT.<br/>STRUCTURAL THINKING.</span></div><div class="cy-studio-copy"><h2 id="studio-title">Human by nature.<br/>Distinct by design.</h2><p class="cy-lede">A strong website needs a clear idea, a considered design, and a careful build.</p><div><p>WebDECOR brings strategy, art direction, and development into one practice. We make websites that connect the way a brand looks with the way its audience explores it.</p><p>Our baseline is simple: useful content, intuitive journeys, and a visual identity with a reason behind every choice. A website should be an expression of the business, down to the last detail.</p></div><a href="/studio/" class="cy-text-link">MEET THE PRACTICE <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></div></section>
<AgencyProcess world={world}/>
<section data-layout-key="questions" class="ag-faq" id="questions" aria-labelledby="faq-title"><div><span class="cy-label">05 / BEFORE WE BEGIN</span><h2 id="faq-title">Good questions.<br/><em>Clear answers.</em></h2><p>A little context for the first conversation.</p><CyberQuestionMark/></div><div class="ag-faq-list">{agency.faqs.map((faq,i)=><details><summary><span>{String(i+1).padStart(2,'0')}</span><h3>{faq.question}</h3><b aria-hidden="true"><Icon name="plus"/></b></summary><p>{faq.answer}</p></details>)}</div></section>
<AgencyInvitation/>
</AgencyLayout>
<script>import '../scripts/agency-services';</script>
