---
import { Image } from 'astro:assets';
import formeCampaign from '../../public/images/forme.webp';
import formeProduct from '../../public/images/cybercore-forme-scan.webp';
import objectCampaign from '../../public/images/object.webp';
import objectProduct from '../../public/images/cybercore-object-wireframe.webp';

interface Props {
  variant: 'forme' | 'object';
  view?: 'landing' | 'detail';
  compact?: boolean;
}
const { variant, view = 'landing', compact = false } = Astro.props;
const object = variant === 'object';
const detail = view === 'detail';
const image = object ? (detail ? objectProduct : objectCampaign) : (detail ? formeProduct : formeCampaign);
const alt = object
  ? (detail ? 'A sculptural metal seat blending photography and construction linework.' : 'Chrome furniture and a green lamp in a yellow architectural setting.')
  : (detail ? 'A black shoulder bag within a scanned material composition.' : 'A silver sculptural bag with red fabric, torn paper, and a blue background.');
const widths = compact ? [320, 480, 640] : [480, 768, 1100];
const sizes = compact ? '(max-width: 760px) calc(100vw - 40px), 600px' : detail ? '(max-width: 760px) calc(100vw - 40px), 65vw' : '(max-width: 760px) calc(100vw - 40px), 75vw';
---
<div class:list={['concept-interface', `interface-${variant}`, `interface-${view}`, { 'interface-compact': compact }]} role="group" aria-label={`${object ? 'OBJECT / ROOM' : 'FORME'} ${detail ? 'detail' : 'landing'} page design`} aria-hidden={compact ? 'true' : undefined}>
  <div class="interface-nav">
    <span class="interface-brand">{object ? 'OBJECT / ROOM' : 'FORME'}</span>
    <div class="interface-links" aria-hidden="true"><span>{object ? 'Collection' : 'Objects'}</span><span>{object ? 'Materials' : 'Approach'}</span><span>Index ↗</span></div>
    <span class="interface-edition">{object ? 'SPATIAL ARCHIVE / 01' : 'COLLECTION / 01'}</span>
  </div>
  {detail ? <>
    <div class="interface-breadcrumb">{object ? 'COLLECTION / SEATING / 01' : 'OBJECTS / TECHNICAL CARRY / 01'}</div>
    <div class="interface-detail-grid">
      <div class="interface-detail-image"><Image src={image} alt={alt} widths={widths} sizes={sizes} format="webp" quality={80} loading="lazy" /><span class="interface-image-index">01 / {object ? 'FORM & CONSTRUCTION' : 'MATERIAL STUDY'}</span></div>
      <div class="interface-details">
        <span class="interface-label">OBJECT 01</span>
        <p class="interface-product-title">{object ? 'Folded\nseat.' : 'Technical\ncarry.'}</p>
        <p class="interface-product-copy">{object ? 'A continuous silhouette. A study in reflection, line, and the space between.' : 'Everyday utility, expressed through texture. A compact object with a precise silhouette.'}</p>
        <dl class="interface-specs">
          <div><dt>{object ? 'Form' : 'Material'}</dt><dd>{object ? 'Continuous curve' : 'Technical fabric'}</dd></div>
          <div><dt>Finish</dt><dd>{object ? 'Reflective metal' : 'Black'}</dd></div>
          <div><dt>{object ? 'Context' : 'Details'}</dt><dd>{object ? 'Interior / seating' : 'Zip pocket, adjustable strap'}</dd></div>
        </dl>
        <div class="interface-detail-note"><span class="interface-label">{object ? 'MATERIAL NOTES' : 'OBJECT NOTES'}</span><p>{object ? 'Photography describes its presence. The drawing describes its construction.' : 'A considered balance of material, proportion, and everyday function.'}</p></div>
      </div>
    </div>
    <div class="interface-bottom"><span>BACK TO {object ? 'THE COLLECTION' : 'ALL OBJECTS'} ↖</span><span>{object ? '02 / LIGHTING' : '02 / THE CAMPAIGN'} ↗</span></div>
  </> : <>
    <div class="interface-intro">
      <div><span class="interface-label">{object ? 'THE SPATIAL ARCHIVE' : 'AN INDEPENDENT POINT OF VIEW'}</span><p class="interface-headline">{object ? 'Objects.\nIn context.' : 'Objects for\nan expressive life.'}</p></div>
      <p class="interface-intro-copy">{object ? 'A collection of forms, materials, and places. Look at the object. Consider the room.' : 'A material-led collection. Familiar objects, seen from a different perspective.'}</p>
    </div>
    <div class="interface-landing-grid">
      <div class="interface-campaign"><Image src={image} alt={alt} widths={widths} sizes={sizes} format="webp" quality={80} loading="lazy" /><div class="interface-campaign-caption"><span>{object ? '01 / A DIFFERENT PERSPECTIVE' : '01 / DESIRE, REFRAMED'}</span><span>VIEW COLLECTION ↗</span></div></div>
      <div class="interface-index"><span class="interface-label">{object ? 'COLLECTION INDEX' : 'OBJECT INDEX'}</span><div class="interface-index-item"><span>01</span><strong>{object ? 'Seating' : 'Technical carry'}</strong><span>↗</span></div><div class="interface-index-item"><span>02</span><strong>{object ? 'Lighting' : 'Sculptural form'}</strong><span>↗</span></div><div class="interface-index-item"><span>03</span><strong>{object ? 'Spaces' : 'Material notes'}</strong><span>↗</span></div><p>{object ? 'An object finds its meaning in the space around it.' : 'Form, function, and a point of view.'}</p><div class="interface-index-mark" aria-hidden="true">{object ? 'O / R' : 'F /'}</div></div>
    </div>
    <div class="interface-bottom"><span>{object ? 'FORM / SPACE / PERSPECTIVE' : 'MATERIAL / FORM / FUNCTION'}</span><span>EDITION 01</span></div>
  </>}
</div>

<style>
  .concept-interface{--ui-paper:#e9e7df;--ui-ink:#22221f;--ui-muted:#62635d;--ui-line:#babbb2;background:var(--ui-paper);color:var(--ui-ink);padding:32px;font-family:'DM Sans Variable',sans-serif;text-align:left;border:1px solid #ffffff17;min-width:0}
  .interface-forme{--ui-paper:#ecece5;--ui-ink:#22231f}
  .interface-object{--ui-paper:#ebe9df;--ui-ink:#24241f}
  .interface-nav{display:flex;flex-wrap:wrap;justify-content:space-between;gap:18px 28px;align-items:center;padding-bottom:22px;border-bottom:1px solid var(--ui-ink)}
  .interface-brand{font:650 26px/1 'Space Grotesk Variable',sans-serif;letter-spacing:-.07em;white-space:nowrap}
  .interface-links{display:flex;flex-wrap:wrap;gap:12px 22px;font-size:12px}
  .interface-edition,.interface-label,.interface-breadcrumb,.interface-campaign-caption,.interface-bottom,.interface-image-index{font:500 12px/1.5 'JetBrains Mono Variable',monospace;letter-spacing:.015em}
  .interface-edition{color:var(--ui-muted);text-align:right}
  .interface-label{display:block;color:var(--ui-muted)}
  .interface-intro{display:grid;grid-template-columns:1.7fr 1fr;gap:48px;align-items:end;padding:48px 0 32px}
  .interface-headline{font:500 clamp(34px,4.7vw,66px)/.99 'Space Grotesk Variable',sans-serif;letter-spacing:-.075em;white-space:pre-line;margin:16px 0 0}
  .interface-intro-copy{font-size:14px;line-height:1.65;max-width:250px;margin:0 0 5px;color:var(--ui-muted)}
  .interface-landing-grid{display:grid;grid-template-columns:minmax(0,3fr) minmax(150px,1fr);gap:28px}
  .interface-campaign{position:relative;background:#dedfd5;min-width:0}
  .interface-campaign img{display:block;width:100%;height:auto;aspect-ratio:1.48;object-fit:cover}
  .interface-campaign-caption{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px 20px;padding:14px 0;border-bottom:1px solid var(--ui-line)}
  .interface-index{padding-top:2px;display:flex;flex-direction:column;min-width:0}
  .interface-index>.interface-label{margin-bottom:20px}
  .interface-index-item{display:grid;grid-template-columns:20px 1fr 14px;gap:8px;align-items:center;padding:14px 0;border-top:1px solid var(--ui-line)}
  .interface-index-item>span{font:400 12px/1.5 'JetBrains Mono Variable',monospace;color:var(--ui-muted)}
  .interface-index-item strong{font-size:13px;font-weight:500}
  .interface-index>p{font-size:13px;line-height:1.65;max-width:180px;color:var(--ui-muted);margin:28px 0 0}
  .interface-index-mark{font:600 clamp(50px,7vw,100px)/1 'Space Grotesk Variable',sans-serif;letter-spacing:-.1em;margin-top:auto;padding-top:30px}
  .interface-bottom{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px 20px;border-top:1px solid var(--ui-ink);margin-top:34px;padding-top:16px;color:var(--ui-muted)}
  .interface-breadcrumb{color:var(--ui-muted);padding:24px 0}
  .interface-detail-grid{display:grid;grid-template-columns:minmax(0,1.8fr) minmax(240px,1fr);gap:38px}
  .interface-detail-image{position:relative;min-width:0;background:#dedfd5}
  .interface-detail-image img{display:block;width:100%;height:100%;aspect-ratio:1;object-fit:cover}
  .interface-image-index{position:absolute;bottom:12px;left:12px;right:12px;width:fit-content;max-width:calc(100% - 24px);padding:6px 8px;background:var(--ui-paper)}
  .interface-details{padding:20px 0 8px}
  .interface-product-title{font:500 clamp(38px,4.6vw,64px)/.98 'Space Grotesk Variable',sans-serif;letter-spacing:-.065em;white-space:pre-line;margin:18px 0 24px}
  .interface-product-copy{font-size:14px;line-height:1.65;color:var(--ui-muted);max-width:320px;margin:0 0 28px}
  .interface-specs{margin:0}
  .interface-specs>div{display:grid;grid-template-columns:70px 1fr;gap:12px;border-top:1px solid var(--ui-line);padding:12px 0;font-size:12px;line-height:1.5}
  .interface-specs dt{color:var(--ui-muted)}
  .interface-specs dd{margin:0}
  .interface-detail-note{border-top:1px solid var(--ui-line);margin-top:24px;padding-top:20px}
  .interface-detail-note p{font-size:12px;line-height:1.65;color:var(--ui-muted);margin:12px 0 0;max-width:290px}
  .interface-compact{padding:20px;pointer-events:none}
  .interface-compact .interface-nav{padding-bottom:14px;gap:12px}
  .interface-compact .interface-brand{font-size:18px}
  .interface-compact .interface-links,.interface-compact .interface-edition{display:none}
  .interface-compact .interface-intro{display:block;padding:26px 0 22px}
  .interface-compact .interface-label{display:none}
  .interface-compact .interface-headline{font-size:clamp(28px,3.7vw,46px);margin:0}
  .interface-compact .interface-intro-copy,.interface-compact .interface-index{display:none}
  .interface-compact .interface-landing-grid{display:block}
  .interface-compact .interface-campaign img{aspect-ratio:1.6}
  .interface-compact .interface-campaign-caption,.interface-compact .interface-bottom{display:none}
  @media(max-width:760px){.concept-interface{padding:20px}.interface-nav{gap:16px;padding-bottom:16px}.interface-brand{font-size:22px}.interface-links{gap:14px}.interface-edition{display:none}.interface-intro{grid-template-columns:1fr;gap:18px;padding:30px 0 24px}.interface-headline{font-size:44px}.interface-intro-copy{max-width:360px;font-size:13px}.interface-landing-grid{grid-template-columns:1fr;gap:26px}.interface-campaign img{aspect-ratio:1.25}.interface-campaign-caption{gap:12px}.interface-index>.interface-label{margin-bottom:12px}.interface-index-item{padding:12px 0}.interface-index>p{max-width:none;font-size:12px;margin-top:16px}.interface-index-mark{display:none}.interface-bottom{margin-top:24px}.interface-detail-grid{grid-template-columns:1fr;gap:24px}.interface-detail-image img{height:auto}.interface-details{padding:0}.interface-product-title{font-size:44px}.interface-product-copy{max-width:none}.interface-detail-note p{max-width:none}.interface-compact{padding:16px}.interface-compact .interface-brand{font-size:17px}.interface-compact .interface-headline{font-size:36px}.interface-compact .interface-campaign img{aspect-ratio:1.5}}
  @media(max-width:390px){.concept-interface{padding:15px}.interface-brand{font-size:20px}.interface-links{gap:10px}.interface-headline{font-size:37px}.interface-compact .interface-headline{font-size:31px}}
</style>
