---
import Icon from '../components/Icon.astro';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/dm-sans';
import '@fontsource/anton';
import '@fontsource/caveat';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/vt323';
import '@fontsource-variable/fredoka';
import '@fontsource-variable/bodoni-moda';
import '../styles/concept-base.css';
import '../styles/cybercore.css';
import '../styles/agency.css';
import '../styles/agency-inner.css';
import '../styles/agency-worlds.css';
import '../styles/agency-compositions.css';
import '../styles/agency-hackerlair.css';
import '../styles/agency-personalities.css';
import '../styles/agency-activation.css';
import '../styles/design-studies.css';
import '../styles/study-preview-cybercore.css';
import '../styles/agency-energy.css';
import '../styles/agency-header.css';
import AgencyHeader from '../components/agency/AgencyHeader.astro';
import AgencyFooter from '../components/agency/AgencyFooter.astro';
import { agency } from '../data/agency';
const { title = 'WebDECOR — Websites with character', description = agency.description, active = 'home', world = 'cybercore', study } = Astro.props;
const theme = {cybercore:'#e6e6e2',collage:'#fff04f',swiss:'#ffffff',hackerlair:'#050907'}[world] || '#e6e6e2';
const terminalFiles=[{id:"home",name:"README.txt",href:"/"},{id:"services",name:"services.sh",href:"/cybercore/services/"},{id:"pricing",name:"pricing.cfg",href:"/cybercore/services/#pricing"},{id:"work",name:"studies/",href:"/explore/"},{id:"studio",name:"studio.md",href:"/cybercore/studio/"},{id:"start",name:"new-project.sh",href:"/cybercore/start/"}];
const terminalFile=terminalFiles.find(file=>file.id===active)?.name||"study.txt";
const canonical = new URL(Astro.url.pathname === '/cybercore/' ? '/' : Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-world={world}>
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title><meta name="description" content={description}/><meta name="theme-color" content={theme}/>
  <script is:inline>try{if(document.documentElement.dataset.world==='cybercore'&&localStorage.getItem('webdecor-activated')==='true'){document.documentElement.dataset.activated='true';document.querySelector('meta[name="theme-color"]').content='#1E1E1E'}}catch{}</script>
  <link rel="icon" href="/agency-favicon.svg" type="image/svg+xml"/><link rel="canonical" href={canonical}/>
  <meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/>
</head>
<body class="cybercore agency">
  <a class="concept-skip" href="#main">Skip to content</a>
  {study&&<div class="wd-study-return"><a href={`/studies/${study.slug}/`}><Icon name="arrow-left"/> BACK TO {study.name.toUpperCase()}</a><span>LIVE DESIGN STUDY / SELF-INITIATED</span><a href="/">WEBDECOR <Icon name="arrow-up-right"/></a></div>}
  <div class="cy-shell">
    <div class="wd-terminal-bar"><a href="/" aria-label="WebDECOR terminal home">[WD] / TERMINAL</a><span>webdecor@studio: ~/{terminalFile}</span><span class="wd-terminal-version">UTF-8 / SHELL 04</span></div>
    <AgencyHeader active={active} world={world}/>
    <aside class="wd-terminal-sidebar" aria-label="Terminal files"><span class="wd-terminal-directory">~/webdecor</span><nav aria-label="Terminal navigation">{terminalFiles.map(file=><a href={file.href} aria-current={active===file.id?'page':undefined}><span aria-hidden="true">{file.id==='work'?'+':'·'}</span>{file.name}</a>)}</nav><div class="wd-terminal-readme"><span>README</span><p>Independent web design.<br/>Human ideas.<br/>Strange output.</p><span>EST. FOR THE<br/>LESS ORDINARY.</span></div></aside>
    <main id="main" data-agency-page={active}><slot/></main><AgencyFooter/>
  </div>
  <span class="cy-sr-only" role="status" data-activation-status></span>
  <script>import '../scripts/agency-header';import '../scripts/agency-world';import '../scripts/agency-motion';import '../scripts/agency-ascii';import '../scripts/agency-activation';import '../scripts/design-studies';import '../scripts/agency-energy';</script>
</body>
</html>
