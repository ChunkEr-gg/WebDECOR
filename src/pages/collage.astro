---
import Icon from '../components/Icon.astro';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import StudyReturn from '../components/StudyReturn.astro';
const projects = [
  { id:'forme', name:'FORME', category:'Fashion & commerce', title:'A little more desire.', image:'/images/forme.webp', alt:'A sculptural silver handbag, red satin and paper cutouts against cobalt blue', description:'An editorial commerce concept for objects with attitude. A bold visual identity, considered product storytelling, and a shopping experience that puts the collection first.', scope:['Art direction','Visual identity','Commerce design'], color:'blue' },
  { id:'object', name:'OBJECT / ROOM', category:'Interiors & culture', title:'Space for a different perspective.', image:'/images/object.webp', alt:'A chrome chair and green lamp in an electric yellow architectural room', description:'A digital showroom concept for a contemporary furniture studio. Expressive layouts meet a calm, intuitive catalogue, giving every object the room it deserves.', scope:['Website strategy','Web design','Astro development'], color:'yellow' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#eaff42" />
    <meta name="description" content="WebDECOR is an independent web design studio creating expressive identities and fast, thoughtful websites for brands with character." />
    <title>WebDECOR — Websites with character</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content="WebDECOR — Websites with character" />
    <meta property="og:description" content="Independent minds. Distinctive design. Websites made to make an impression." />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={Astro.site} />
    <meta property="og:url" content={Astro.site} />
  </head>
  <body>
    <StudyReturn slug="collage" name="Collage"/>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="header">
      <a class="logo" href="#" aria-label="WebDECOR home">Web<span>DECOR</span><i aria-hidden="true"><Icon name="burst"/></i></a>
      <nav aria-label="Main navigation"><a href="#work">The work</a><a href="#studio">The studio</a><a href="#services">What we do</a></nav>
      <button class="button button-dark nav-cta" data-brief>Start a project<span class="button-dot" aria-hidden="true"></span></button>
      <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-nav"><span></span><span></span></button>
    </header>
    <nav id="mobile-nav" class="mobile-nav" aria-label="Mobile navigation" hidden><a href="#work">The work</a><a href="#studio">The studio</a><a href="#services">What we do</a><button data-brief>Start a project</button></nav>
    <main id="main">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-top"><span class="eyebrow"><span class="tiny-star" aria-hidden="true"><Icon name="burst"/></span> INDEPENDENT WEB DESIGN STUDIO</span><span class="hero-note">Good people.<br/>Really good websites.</span></div>
        <div class="hero-grid">
          <div class="hero-copy"><h1 id="hero-title">WEBSITES<br/>WITH<br/><span class="character">CHARACTER<span class="period">.</span></span></h1><p>For brands that have something to say.<br/>We make sure the world feels it.</p><a class="button button-dark hero-cta" href="#work">Meet your next website<span class="button-dot" aria-hidden="true"></span></a></div>
          <div class="collage" aria-label="Creative collage artwork">
            <div class="blue-scrap" aria-hidden="true"></div><div class="scribble" aria-hidden="true"><Icon name="burst"/></div>
            <div class="art-frame"><span class="tape" aria-hidden="true"></span><img src="/images/hero.webp" alt="A marble bust with a cobalt glass sphere in an orange editorial paper collage" width="1024" height="1280" fetchpriority="high" /><span class="image-caption">A FRESH POINT OF VIEW / WEBDECOR</span></div>
            <div class="round-sticker" aria-hidden="true">GOOD<br/>TASTE.<br/><span>GREAT WEBSITES.</span></div>
            <div class="paper-label">BORING IS BAD<br/>FOR BUSINESS.</div>
            <span class="collage-side" aria-hidden="true">A LITTLE DIFFERENT. A LOT YOU.</span>
          </div>
        </div>
        <div class="hero-bottom"><span>Strategy meets a little creative chaos.</span><div class="mini-tags"><span>DESIGN</span><span>DEVELOPMENT</span><span>BRAND THINKING</span></div><a href="#work" class="scroll-link">SCROLL TO EXPLORE <span aria-hidden="true"><Icon name="arrow-down"/></span></a></div>
      </section>
      <div class="ticker" aria-hidden="true"><div>GOOD DESIGN HAS A POINT OF VIEW <span><Icon name="burst"/></span> MAKE YOURSELF UNMISSABLE <span><Icon name="burst"/></span> GOOD DESIGN HAS A POINT OF VIEW <span><Icon name="burst"/></span> MAKE YOURSELF UNMISSABLE <span><Icon name="burst"/></span></div></div>
      <section id="work" class="work section-pad" aria-labelledby="work-title">
        <div class="section-top"><span class="eyebrow">01 / SELECTED CONCEPTS</span><span class="small-note">A glimpse of what could be.</span></div>
        <div class="section-heading"><h2 id="work-title">A LITTLE OUT OF<br/><span class="serif">the ordinary.</span></h2><p>Different brands. Different worlds.<br/>One thing in common: a website<br/>that could only be theirs.</p></div>
        <div class="projects">
          {projects.map((project,index)=><button class={`project-card ${project.color}`} data-case={project.id} aria-label={`Explore ${project.name} concept`}><div class="project-visual"><div class="mock-nav"><span>{project.name}</span><span>OBJECTS, WITH ATTITUDE</span><span aria-hidden="true"><Icon name="menu"/></span></div><img src={project.image} alt={project.alt} width="1365" height="1024" loading="lazy"/><div class="project-art-title">{project.id==='forme'?'Objects of':'Room for'}<br/><em>{project.id==='forme'?'desire.':'possibility.'}</em></div><span class="case-tag">EXPLORE CONCEPT <span aria-hidden="true"><Icon name="plus"/></span></span></div><div class="project-meta"><div><h3>{project.name}</h3><span>{project.category}</span></div><span class="project-number">0{index+1}</span></div></button>)}
        </div>
      </section>
      <section id="studio" class="studio section-pad" aria-labelledby="studio-title">
        <div class="studio-label"><span class="eyebrow">02 / THE STUDIO</span><span class="studio-star" aria-hidden="true"><Icon name="burst"/></span><span class="handwritten">a little personality<br/>goes a long way</span></div>
        <div class="studio-copy"><h2 id="studio-title">THE INTERNET<br/>HAS ENOUGH<br/><span class="underlined">SAME-SAME.</span></h2><p>We're WebDECOR. An independent studio for ambitious people who want their business to look, feel, and work like itself.</p><p>We bring curious thinking, a sharp eye, and thoughtful development to every project. A distinctive first impression. A frictionless experience. A website you'll be proud to put your name on.</p><a class="text-link" href="#services">Here's how we make it happen <span aria-hidden="true"><Icon name="plus"/></span></a></div>
      </section>
      <section id="services" class="services section-pad" aria-labelledby="services-title">
        <div class="service-intro"><span class="eyebrow">03 / WHAT WE DO</span><h2 id="services-title">BIG IDEAS.<br/>EVERY LITTLE<br/><span class="serif">detail.</span></h2><p>From the first “what if” to the final click.<br/>We connect the dots.</p><div class="service-sticker" aria-hidden="true">MADE WITH<br/>INTENTION.<span><Icon name="burst"/></span></div></div>
        <div class="service-list">
          <details open><summary><span class="service-number">01</span><span>Web design</span><span class="expand" aria-hidden="true"></span></summary><div class="service-content"><p>Distinctive on the outside. Intuitive on the inside. We design websites around your brand and the people who use it.</p><div class="service-tags"><span>Art direction</span><span>UX & UI</span><span>Responsive design</span></div></div></details>
          <details><summary><span class="service-number">02</span><span>Development</span><span class="expand" aria-hidden="true"></span></summary><div class="service-content"><p>We turn great designs into fast, accessible websites. Clean foundations, purposeful motion, and an experience that works beautifully on every screen.</p><div class="service-tags"><span>Astro websites</span><span>Performance</span><span>Accessibility</span></div></div></details>
          <details><summary><span class="service-number">03</span><span>Brand thinking</span><span class="expand" aria-hidden="true"></span></summary><div class="service-content"><p>A clear point of view makes every decision easier. We help you define your story, sharpen your identity, and find a visual language that feels like you.</p><div class="service-tags"><span>Positioning</span><span>Visual identity</span><span>Content direction</span></div></div></details>
        </div>
      </section>
      <section class="process section-pad" aria-labelledby="process-title"><div class="section-top"><span class="eyebrow">04 / A GOOD WORKING RELATIONSHIP</span><h2 id="process-title">Great work starts with a conversation.</h2></div><div class="steps"><article><span class="step-number">01.</span><h3>Get curious.</h3><p>Your goals, your audience, your point of view. We ask good questions and listen closely.</p></article><article><span class="step-number">02.</span><h3>Make it yours.</h3><p>Ideas become a direction. We design, share, and refine together until everything clicks.</p></article><article><span class="step-number">03.</span><h3>Make it real.</h3><p>Build, refine, and launch with care. A thoughtful handover sets you up for what's next.</p></article></div></section>
      <section class="contact section-pad" aria-labelledby="contact-title"><div class="contact-top"><span class="eyebrow">YOUR NEXT CHAPTER STARTS HERE</span><span class="contact-stamp" aria-hidden="true">LET'S<br/>DO THIS.</span></div><h2 id="contact-title">LET'S MAKE<br/>SOMETHING <span class="serif">click.</span></h2><div class="contact-bottom"><p>A new website. A fresh perspective.<br/>A big idea you've been sitting on.</p><button class="button button-dark contact-cta" data-brief>Start a project<span class="button-dot" aria-hidden="true"></span></button></div></section>
    </main>
    <footer><a class="logo" href="#" aria-label="Back to WebDECOR home">Web<span>DECOR</span><i aria-hidden="true"><Icon name="burst"/></i></a><span>Independent minds. Unmistakable websites.</span><span>© {new Date().getFullYear()} WebDECOR</span><a href="#" class="back-top">BACK TO TOP <Icon name="arrow-up"/></a></footer>
    <dialog id="brief-dialog" class="brief-dialog" aria-labelledby="brief-title"><button class="dialog-close" data-close aria-label="Close project brief"><Icon name="close"/></button><span class="eyebrow">LET'S GET SOMETHING STARTED</span><h2 id="brief-title">A fresh start.<br/><span class="serif">A clear brief.</span></h2><p>Tell us what you're thinking. Create a brief you can keep, refine, and share with your team.</p><form id="brief-form"><div class="form-row"><label>Your name<input name="name" autocomplete="name" required placeholder="Alex Taylor" maxlength="120" /></label><label>Brand or business<input name="brand" autocomplete="organization" required placeholder="Your next big thing" maxlength="150" /></label></div><label>What do you have in mind?<textarea name="idea" required rows="3" placeholder="A new site, a fresh identity, a better way to tell your story…" maxlength="4000"></textarea></label><label>Where should we start?<select name="service"><option>Website design & development</option><option>Website redesign</option><option>Brand & website</option><option>Let's figure it out together</option></select></label><button type="submit" class="button button-dark">Download your brief<span class="button-dot" aria-hidden="true"></span></button><p class="form-note" id="brief-status" role="status">Your brief stays on your device. No message is sent.</p></form></dialog>
    {projects.map(project=><dialog id={`case-${project.id}`} class="case-dialog" aria-labelledby={`case-title-${project.id}`}><button class="dialog-close" data-close aria-label="Close project"><Icon name="close"/></button><img src={project.image} alt={project.alt} width="1365" height="1024" loading="lazy"/><div class="case-body"><span class="eyebrow">PORTFOLIO CONCEPT / {project.category}</span><h2 id={`case-title-${project.id}`}>{project.name}</h2><h3>{project.title}</h3><p>{project.description}</p><div class="case-scope">{project.scope.map(item=><span>{item}</span>)}</div><button class="button button-dark" data-brief>Imagine your brand here<span class="button-dot" aria-hidden="true"></span></button></div></dialog>)}

    <script>
      const brief = document.querySelector<HTMLDialogElement>('#brief-dialog');
      const mobile = document.querySelector<HTMLElement>('#mobile-nav');
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const closeMenu = () => { if (mobile && toggle) { mobile.hidden = true; toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label','Open navigation'); } };
      toggle?.addEventListener('click', () => { if (!mobile) return; const open=mobile.hidden;mobile.hidden=!open;toggle.setAttribute('aria-expanded',String(open));toggle.setAttribute('aria-label',open?'Close navigation':'Open navigation'); });
      mobile?.querySelectorAll('a').forEach(a=>a.addEventListener('click',closeMenu));
      const openDialog=(dialog:HTMLDialogElement | null | undefined)=>{document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach(d=>d.close());closeMenu();dialog?.showModal();};
      document.querySelectorAll('[data-brief]').forEach(button=>button.addEventListener('click',()=>openDialog(brief)));
      document.querySelectorAll<HTMLElement>('[data-case]').forEach(button=>button.addEventListener('click',()=>openDialog(document.querySelector<HTMLDialogElement>(`#case-${button.dataset.case}`))));
      document.querySelectorAll<HTMLDialogElement>('dialog').forEach(dialog=>{dialog.querySelector('[data-close]')?.addEventListener('click',()=>dialog.close());dialog.addEventListener('click',event=>{if(event.target!==dialog)return;const r=dialog.getBoundingClientRect();if(event.clientX<r.left||event.clientX>r.right||event.clientY<r.top||event.clientY>r.bottom)dialog.close();});});
      document.querySelector<HTMLFormElement>('#brief-form')?.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const data=new FormData(form);const contents=`WEBDECOR — PROJECT BRIEF\n\nName: ${data.get('name')}\nBrand: ${data.get('brand')}\nFocus: ${data.get('service')}\n\nThe idea\n${data.get('idea')}\n\nNext steps\nDefine your audience, gather brand assets, and set your ideal launch date.\n`;const url=URL.createObjectURL(new Blob([contents],{type:'text/plain;charset=utf-8'}));const a=document.createElement('a');a.href=url;a.download='webdecor-project-brief.txt';document.body.append(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);const status=document.querySelector('#brief-status');if(status)status.textContent='Your brief is ready. Keep it handy for your first conversation.';});
    </script>
  </body>
</html>
