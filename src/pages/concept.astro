---
// Concept for the next WebDECOR site: a clean product-style page; the hero and closing sections are rendered with Paper Shaders.
// It stands apart from the current site: own layout, own styles, not in the sitemap, and not indexed.
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource-variable/bodoni-moda';
import '@fontsource-variable/bodoni-moda/wght-italic.css';
import '@fontsource-variable/fredoka';
import '@fontsource/anton';
import '@fontsource/caveat';
import '../styles/concept-character.css';
import { ArrowUpRight, Check, Gauge, MessagesSquare, Palette, Rocket, Smartphone } from 'lucide-static';
import CharacterDemo from '../components/concept/CharacterDemo.astro';
import { agency } from '../data/agency';

const title = 'WebDECOR — Websites with character (concept)';
const description = 'A two-person studio designing and building websites for small local and creative businesses.';
const showcase = [
  { href: '/work/forme/', label: 'FORME', kind: 'Fashion study', image: '/images/forme-800.webp', alt: 'A chrome handbag on red satin and checkerboard paper' },
  { href: '/studies/collage/', label: 'Collage', kind: 'Lab world', image: '/images/collage-playground-640.webp', alt: 'Cut-paper shapes, a googly-eyed figure and a smiling hand on yellow' },
  { href: '/work/object/', label: 'Object / Room', kind: 'Showroom study', image: '/images/object-800.webp', alt: 'A chrome chair and a mushroom lamp in a sunlit yellow room' },
];
const features = [
  { icon: Palette, name: 'Your own look', text: 'Type, colour and imagery chosen for your business, not for everyone’s.' },
  { icon: Smartphone, name: 'Phone first', text: 'Most visitors arrive on a phone, so every page is designed for it first.' },
  { icon: Gauge, name: 'Fast and accessible', text: 'Light pages, readable text and full keyboard support.' },
  { icon: MessagesSquare, name: 'A direct line', text: 'You talk to the two people who design and build your site.' },
];
const steps = [
  { name: 'Say hello', text: 'Email us or send a short brief. We reply with questions, not a sales pitch.' },
  { name: 'Find the direction', text: 'We explore type, colour, imagery and tone, and show you the direction on real pages.' },
  { name: 'Design and build', text: 'We design every page for phones and desktops, then build the site ourselves.' },
  { name: 'Launch', text: 'We put the site live on your domain and show you how to keep it up to date.' },
];
const planNotes: Record<string, string> = { essential: 'Best for new businesses', expanded: 'For more pages and stories', custom: 'For shops, bookings and more' };
const icon = (svg: string) => svg.replace('<svg', '<svg aria-hidden="true" focusable="false"');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{title}</title><meta name="description" content={description}/><meta name="robots" content="noindex"/>
  <meta name="theme-color" content="#05060f"/>
  <link rel="icon" href="/agency-favicon.svg" type="image/svg+xml"/>
  <script is:inline>document.documentElement.classList.add('js');try{if(localStorage.getItem('webdecor-concept-cybercore')==='true')document.documentElement.dataset.on='true'}catch{}</script>
</head>
<body class="cx">
  <a class="cx-skip" href="#main">Skip to content</a>

  <header class="cx-header" data-header>
    <a class="cx-brand" href="#top" aria-label="WebDECOR, back to top">
      <svg viewBox="0 0 300 300" aria-hidden="true"><g transform="translate(6.5 63)" fill="none" stroke="currentColor" stroke-width="25" stroke-linecap="square" stroke-linejoin="round"><path d="M20 65v64q0 18 18 18h24V91h30v56h25q18 0 18-18V65"/><path d="M241 27v119h-68q-23 0-23-23V89q0-24 24-24h64"/></g><path d="M258.5 188h27v27h-27z" fill="#ff3616"/></svg>
      <span>WebDECOR</span>
    </a>
    <nav class="cx-nav" aria-label="Page sections"><a href="#features">Features</a><a href="#work">Work</a><a href="#pricing">Pricing</a><a href="#faq">FAQ</a></nav>
    <div class="cx-header-end">
      <button class="cx-switch" type="button" role="switch" aria-checked="false" data-concept-switch><span class="cx-switch-track" aria-hidden="true"><span></span></span><span class="cx-switch-label">Cybercore</span></button>
      <a class="cx-btn cx-btn-light cx-btn-small" href="/start/">Start a project</a>
    </div>
  </header>

  <main id="main">
    <section class="cx-hero" id="top" aria-labelledby="cx-hero-title">
      <div class="cx-shader" data-shader="hero" aria-hidden="true"></div>
      <p class="cx-pill" data-reveal>A two-person web design studio</p>
      <h1 id="cx-hero-title" data-reveal>Websites with<br/><em>character.</em></h1>
      <p class="cx-hero-sub" data-reveal>We design and build websites for small local and creative businesses. Each one gets a look of its own.</p>
      <div class="cx-actions" data-reveal>
        <a class="cx-btn cx-btn-light" href="/start/">Start a project <Fragment set:html={icon(ArrowUpRight)}/></a>
        <a class="cx-btn cx-btn-glass" href="#pricing">See pricing</a>
      </div>
      <div class="cx-hero-cards">
        {showcase.map(item => <a class="cx-hcard" href={item.href}><span class="cx-hcard-label"><span>{item.label}</span><span>{item.kind}</span></span><img src={item.image} alt={item.alt} width="800" height="600" fetchpriority="high"/></a>)}
      </div>
    </section>

    <section class="cx-section cx-features" id="features" aria-labelledby="cx-features-title">
      <div class="cx-wrap">
        <div class="cx-head" data-reveal><p class="cx-kicker">Features</p><h2 class="cx-h2" id="cx-features-title">A website that could only be yours.</h2><p class="cx-lead">Most small business sites start from the same template. Ours start from your business, then we design every page and build it ourselves.</p></div>
        <div class="cx-demo-card" data-reveal><CharacterDemo/></div>
        <ul class="cx-features-list">
          {features.map(f => <li data-reveal><span class="cx-icon" set:html={icon(f.icon)}/><h3>{f.name}</h3><p>{f.text}</p></li>)}
        </ul>
      </div>
    </section>

    <section class="cx-section cx-work" id="work" aria-labelledby="cx-work-title">
      <div class="cx-wrap">
        <div class="cx-head cx-head-row" data-reveal><div><p class="cx-kicker">Work</p><h2 class="cx-h2" id="cx-work-title">Studies and experiments.</h2></div><p class="cx-lead">Concept projects and lab worlds that show the range of what we make.</p></div>
        <div class="cx-work-grid">
          <a class="cx-work-card" href="/work/forme/" data-reveal><span class="cx-work-image"><img src="/images/forme-800.webp" alt="A chrome handbag on red satin and checkerboard paper" width="800" height="600" loading="lazy"/></span><span class="cx-work-meta"><strong>FORME</strong><span>Fashion storefront · Design study</span></span></a>
          <a class="cx-work-card" href="/work/object/" data-reveal><span class="cx-work-image"><img src="/images/object-800.webp" alt="A chrome chair and a mushroom lamp in a sunlit yellow room" width="800" height="600" loading="lazy"/></span><span class="cx-work-meta"><strong>Object / Room</strong><span>Furniture showroom · Design study</span></span></a>
        </div>
        <a class="cx-lab" href="/explore/" data-reveal><span><strong>The lab</strong> Collage, Swiss, Hackerlair and The Weird Internet: four experimental site worlds.</span><Fragment set:html={icon(ArrowUpRight)}/></a>
      </div>
    </section>

    <section class="cx-section cx-process" id="process" aria-labelledby="cx-process-title">
      <div class="cx-wrap">
        <div class="cx-head" data-reveal><p class="cx-kicker">Process</p><h2 class="cx-h2" id="cx-process-title">How a project runs.</h2></div>
        <ol class="cx-steps">{steps.map((s, i) => <li data-reveal><span>0{i + 1}</span><h3>{s.name}</h3><p>{s.text}</p></li>)}</ol>
      </div>
    </section>

    <section class="cx-section cx-pricing" id="pricing" aria-labelledby="cx-pricing-title">
      <div class="cx-wrap">
        <div class="cx-head cx-head-center" data-reveal><p class="cx-kicker">Pricing</p><h2 class="cx-h2" id="cx-pricing-title">Straightforward pricing.</h2><p class="cx-lead">Fixed prices for most projects. Anything bigger is quoted up front.</p></div>
        <div class="cx-plans">
          {agency.pricing.map(plan => (
            <article class:list={['cx-plan', { 'cx-plan-featured': plan.id === 'essential' }]} data-reveal>
              <p class="cx-plan-note">{planNotes[plan.id]}</p>
              <h3>{plan.name}</h3>
              <p class="cx-plan-price">{plan.id === 'custom' ? 'Quoted' : plan.price}</p>
              <p class="cx-plan-text">{plan.description}</p>
              <ul>{plan.features.map(f => <li><Fragment set:html={icon(Check)}/>{f}</li>)}</ul>
              <a class:list={['cx-btn', plan.id === 'essential' ? 'cx-btn-accent' : 'cx-btn-line']} href={`/start/?plan=${plan.id}`}>{plan.id === 'custom' ? 'Ask for a quote' : `Choose ${plan.name}`}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cx-section cx-faq" id="faq" aria-labelledby="cx-faq-title">
      <div class="cx-wrap cx-faq-grid">
        <div data-reveal><p class="cx-kicker">FAQ</p><h2 class="cx-h2" id="cx-faq-title">Questions.</h2><p class="cx-lead">Something else? Email <a href={`mailto:${agency.email}`}>{agency.email}</a>.</p></div>
        <div class="cx-faq-list" data-reveal>{agency.faqs.map(f => <details><summary>{f.question}<span class="cx-plus" aria-hidden="true"></span></summary><p>{f.answer}</p></details>)}</div>
      </div>
    </section>

    <section class="cx-final" aria-labelledby="cx-final-title">
      <div class="cx-final-box" data-reveal>
        <div class="cx-shader" data-shader="final" aria-hidden="true"></div>
        <h2 id="cx-final-title">Tell us about your <em>business.</em></h2>
        <p>Send a few lines about what you do. We'll reply with questions and next steps.</p>
        <div class="cx-actions"><a class="cx-btn cx-btn-light" href="/start/">Start a project <Fragment set:html={icon(ArrowUpRight)}/></a><a class="cx-btn cx-btn-glass" href={`mailto:${agency.email}`}>{agency.email}</a></div>
      </div>
    </section>
  </main>

  <footer class="cx-footer">
    <div class="cx-wrap cx-footer-row">
      <a class="cx-brand" href="#top" aria-label="WebDECOR, back to top"><svg viewBox="0 0 300 300" aria-hidden="true"><g transform="translate(6.5 63)" fill="none" stroke="currentColor" stroke-width="25" stroke-linecap="square" stroke-linejoin="round"><path d="M20 65v64q0 18 18 18h24V91h30v56h25q18 0 18-18V65"/><path d="M241 27v119h-68q-23 0-23-23V89q0-24 24-24h64"/></g><path d="M258.5 188h27v27h-27z" fill="#ff3616"/></svg><span>WebDECOR</span></a>
      <nav aria-label="Footer"><a href="#features">Features</a><a href="#work">Work</a><a href="#pricing">Pricing</a><a href="/explore/">The lab</a><a href={`mailto:${agency.email}`}>{agency.email}</a></nav>
    </div>
    <p class="cx-wrap cx-footer-base"><span>© 2026 WebDECOR · Websites with character</span><span>Concept preview · <a href="/">Current site</a></span></p>
  </footer>

  <script>import '../scripts/concept-character';</script>
</body>
</html>
