---
import StudioLayout from '../layouts/StudioLayout.astro';
import Icon from '../components/Icon.astro';
import AgencyInquiry from '../components/AgencyInquiry.astro';
import { agency } from '../data/agency';
const founder = 'founder' in agency ? String(agency.founder) : '';
---
<StudioLayout title="Start a project — WebDECOR" active="start" description="Email Max at WebDECOR to discuss your website, or prepare a project brief to share.">
  <section class="site-wrap site-section start-intro">
    <p class="site-kicker">Start a project</p><h1 class="site-heading">What do you<br />have in mind?</h1>
    <p class="site-lede">A new website, a redesign, or an idea to explore. {founder ? `Tell ${founder}` : 'Tell us'} what you need and we can define a useful starting point.</p>
    {(agency.email || agency.bookingUrl) ? <div class="direct-contact">{agency.email && <><a class="site-button" href={`mailto:${agency.email}`}>Email {founder || 'WebDECOR'} <Icon name="arrow-up-right" /></a><a class="contact-address" href={`mailto:${agency.email}`}>{agency.email}</a></>}{agency.bookingUrl && <a class="site-button secondary" href={agency.bookingUrl} target="_blank" rel="noopener noreferrer">Book an introduction <Icon name="arrow-up-right" /></a>}</div> : <p class="contact-note">Direct contact is not yet available. You can prepare a brief below and keep it on your device.</p>}
    <p class="start-note">No finished brief needed. Your goal, an existing website link, and a rough budget or timing are useful if you have them.</p>
    <a class="brief-link" href="#project-brief">Prefer to organise your thoughts first? Write a brief <Icon name="arrow-down" /></a>
  </section>
  <section class="site-wrap site-section site-rule brief-section" id="project-brief" aria-labelledby="brief-title">
    <aside><p class="site-kicker">Optional / Project brief</p><h2 id="brief-title">Put the essentials<br />in one place.</h2><p>This tool runs in your browser. {agency.email ? 'Open a draft in your email app, review it, and send it when you are ready. You can also download a copy.' : 'Download a text copy to keep, edit, and share.'}</p><p class="brief-privacy">Nothing is submitted through this website. Your answers stay on your device until you choose to email or share them.</p></aside>
    <AgencyInquiry email={agency.email} bookingUrl={agency.bookingUrl} services={agency.services} pricing={agency.pricing} brand={agency.name} showContactLinks={false} />
  </section>
</StudioLayout>
<style>
  .start-intro .site-lede {max-width:660px}.direct-contact {display:flex;align-items:center;flex-wrap:wrap;gap:16px;margin-top:28px}.contact-address {text-decoration:underline!important;display:inline-flex;align-items:center;min-height:44px;text-underline-offset:5px}.start-note {color:var(--site-muted);font-size:14px;line-height:1.65;max-width:620px;margin:24px 0 0}.contact-note {max-width:620px;padding:20px;background:var(--site-panel);line-height:1.65}.brief-link {text-decoration:underline!important;display:inline-flex;align-items:center;gap:8px;min-height:44px;margin-top:20px;line-height:1.5;text-underline-offset:5px}.brief-link svg {width:16px;flex-shrink:0}.brief-section {display:grid;grid-template-columns:.8fr 1.2fr;gap:64px;scroll-margin-top:100px}.brief-section aside h2 {font-family:'Space Grotesk Variable',sans-serif;font-size:clamp(28px,3.5vw,40px);line-height:1.12;letter-spacing:-.035em;margin:12px 0 22px}.brief-section aside p:not(.site-kicker) {max-width:420px;color:var(--site-muted);line-height:1.65}.brief-privacy {font-size:14px;margin-top:24px}
  @media(max-width:800px){.brief-section {grid-template-columns:1fr;gap:32px}.brief-section aside p:not(.site-kicker) {max-width:620px}.brief-privacy {margin-top:16px}}
  @media(max-width:480px){.direct-contact {align-items:flex-start;flex-direction:column;gap:8px}.brief-link {text-decoration:underline!important;align-items:flex-start;padding-top:12px}}
</style>
