---
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/UndergroundLayout.astro';
import Pricing from '../../components/underground/Pricing.astro';
import FAQ from '../../components/underground/FAQ.astro';
import Invitation from '../../components/underground/Invitation.astro';
import Proof from '../../components/agency/ResponsiveStudy.astro';
import {agency} from '../../data/agency';
---
<Layout title="Services — WebDECOR" active="services"><section class="u-page-cover" data-window="Services / The creative toolkit"><span class="u-meta">01 / THE CREATIVE TOOLKIT</span><h1>SERVICES<span class="u-hand-note">a little chaos.<br/>a lot of craft.</span></h1><div class="u-cover-split"><div><h2>The idea.<br/>The identity.<br/>The entire experience.</h2><p>From the first question to the final interaction. We connect strategy, art direction, and development around what your website needs to achieve.</p><a class="u-action" href="/weird-internet/start/">DEFINE YOUR PROJECT</a></div><figure class="u-paper-image"><img src="/images/crt-foil.webp" alt="A crumpled metallic photocopy catching the light" width="1280" height="1280"/><figcaption class="u-meta">RAW MATERIAL / DIGITAL EXPRESSION</figcaption></figure></div></section><nav class="u-service-index" aria-label="Services on this page">{agency.services.map(service=><a href={`#${service.id}`}><span>{service.number}</span>{service.name}</a>)}</nav>{agency.services.map((service,i)=><section id={service.id} class={`u-service-detail u-editorial-section ${i%2?'u-paper-section':''}`} data-window="Services / Project details"><div><span class="u-meta">{service.number} / {service.name.toUpperCase()}</span><h2>{service.line}</h2><p>{service.description}</p><a class="u-action" href={`/weird-internet/start/?service=${service.id}`}>START WITH {service.name.toUpperCase()}</a></div><aside><div class="u-card-title"><span>project_elements.txt</span><span aria-hidden="true"><Icon name="maximize"/></span></div><span class="u-meta">PROJECT ELEMENTS</span><ul>{service.deliverables.map(item=><li>{item}</li>)}</ul><p class="u-hand-note">{service.outcome}</p></aside>{service.id==='build'&&<div class="u-proof-wrap"><h3>Same character. Different canvas.</h3><p>Switch the viewport to see the same content adapt.</p><Proof id="underground-services-proof"/></div>}</section>)}<Pricing/><FAQ/><Invitation/></Layout>
