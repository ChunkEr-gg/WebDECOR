---
import Layout from '../../../layouts/UndergroundLayout.astro';
import Invitation from '../../../components/underground/Invitation.astro';
import Proof from '../../../components/agency/ResponsiveStudy.astro';
import {studies} from '../../../data/agency';
export function getStaticPaths(){return studies.map(study=>({params:{slug:study.slug},props:{study}}))}
const {study}=Astro.props;
const next=studies.find(item=>item.slug!==study.slug)!;
const object=study.slug==='object';
---
<Layout title={`${study.name} — Design study — WebDECOR`} active="work" description={study.summary}><article class="u-case"><section class="u-page-cover" data-window="Design study / Open archive"><a class="u-meta" href="/weird-internet/#u-work">DESIGN STUDIES / {study.number}</a><h1>{object?<>OBJECT<br/>/ ROOM</>:study.name}<span class="u-hand-note">{object?'a different perspective.':'desire, reframed.'}</span></h1><div class="u-case-intro"><span class="u-meta">{study.category}</span><p>{study.summary}</p><p class="u-meta">SELF-INITIATED DESIGN STUDY / NOT A CLIENT COMMISSION OR LIVE BUSINESS.</p></div><figure class="u-case-image"><img src={study.image} alt={study.alt} width={study.width} height={study.height}/><figcaption class="u-meta">WD / STUDY {study.number} / IMAGE — FORM — INTERFACE</figcaption></figure></section><section class="u-case-story u-editorial-section u-paper-section" data-window="Design study / Direction and experience"><div><span class="u-meta">THE QUESTION</span><h2>{study.challenge}</h2></div><div><article><span class="u-meta">VISUAL DIRECTION</span><p>{study.direction}</p></article><article><span class="u-meta">THE EXPERIENCE</span><p>{study.experience}</p></article><ul>{study.deliverables.map(item=><li>{item}</li>)}</ul></div></section><section class="u-editorial-section u-case-interface" data-window="Preview / The interface"><span class="u-meta">FROM ART DIRECTION TO INTERFACE</span><h2>{object?'An archive you can move through.':'Expression meets a clear hierarchy.'}</h2><p>{object?'The object and its setting lead the composition. Quiet navigation and an archival index leave space for the work.':'Campaign imagery gives the collection a signature. Clear object labels and a measured hierarchy make it easy to explore.'}</p><Proof variant={study.slug} id={`underground-${study.slug}-proof`}/></section><section class="u-case-spec u-editorial-section" data-window="Design study / Visual DNA"><article><span class="u-meta">01 / TYPOGRAPHIC CONTRAST</span><h2>{object?'Object. Space. Perspective.':'Form. Function. Feeling.'}</h2><p>Display expression and precise utility type.</p></article><article><span class="u-meta">02 / PALETTE</span><div class="u-swatches"><span>INK</span><span>PAPER</span><span>SIGNAL</span></div><p>Monochrome makes room for the imagery. Vermilion marks the moments that deserve attention.</p></article><article><span class="u-meta">03 / MATERIAL DETAIL</span><img src={study.image} alt={object?'Close crop of the chair and its wireframe drawing':'Close crop of the bag texture and scan marks'} width={study.width} height={study.height} loading="lazy"/></article></section><section class="u-editorial-section u-case-journey" data-window="Design study / Visitor journey"><span class="u-meta">A CONCEPTUAL JOURNEY</span><h2>{study.headline}</h2><p>The image brings the atmosphere. The interface gives visitors a clear next step.</p><ol>{study.sequence.map((step,i)=><li><span class="u-meta">0{i+1}</span><h3>{step}</h3></li>)}</ol></section><a class="u-next-study" href={`/weird-internet/work/${next.slug}/`}><span class="u-meta">NEXT / DESIGN STUDY</span><strong>{next.name}</strong></a></article><Invitation/></Layout>
