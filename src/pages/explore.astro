---
import { Image } from 'astro:assets';
import StudioLayout from '../layouts/StudioLayout.astro';
import Icon from '../components/Icon.astro';
import { designStudies } from '../data/design-studies';
import collage from '../../public/images/collage-playground.webp';
import eye from '../../public/images/crt-eye.webp';
import chair from '../../public/images/object.webp';
const art = { collage, hackerlair: eye, 'weird-internet': chair };
---
<StudioLayout title="Design Lab — WebDECOR" active="lab" description="Four self-initiated experiments in art direction and interaction. Explore Collage, Swiss, Hackerlair, and The Weird Internet.">
  <div class="site-wrap">
    <section class="lab-intro">
      <p class="site-kicker">Design Lab / Self-initiated experiments</p>
      <h1 class="site-heading">Room to experiment.</h1>
      <p class="site-lede">Cybercore is WebDECOR’s house style. These four studies explore other directions for different brands, audiences, and experiences.</p>
      <p class="lab-note">Open a study for the design thinking, or enter its live experience to try the interaction.</p>
    </section>
    <section class="lab-grid" aria-label="Design experiments">
      {designStudies.map(study => <article class={`lab-card lab-${study.slug}`}>
        <a class="lab-art" href={`/studies/${study.slug}/`} aria-label={`Read the ${study.name} design study`}>
          <span class="lab-art-label">{study.number} / {study.name}</span>
          <strong>{study.headline}</strong>
          {art[study.slug] && <Image src={art[study.slug]} alt="" widths={[320, 480, 640]} sizes="(max-width: 680px) 50vw, 260px" loading="lazy" />}
          {study.slug === 'swiss' && <span class="lab-swiss-symbol" aria-hidden="true">+</span>}
        </a>
        <div class="lab-card-copy"><p class="site-kicker">{study.label}</p><h2>{study.name}</h2><p>{study.summary}</p><div class="lab-actions"><a class="site-text-link" href={`/studies/${study.slug}/`}>Read the study <Icon name="arrow-right" /></a><a class="site-text-link" href={study.live}>Try it live <Icon name="arrow-up-right" /></a></div></div>
      </article>)}
    </section>
    <section class="site-section lab-outro"><div><p class="site-kicker">For your own website</p><h2>A direction that fits your business.</h2></div><div><p>Experiments help explore the possibilities. A real project starts with your audience, content, and goals.</p><a class="site-button" href="/start/">Discuss a project <Icon name="arrow-up-right" /></a></div></section>
  </div>
</StudioLayout>
<style>
.lab-intro{padding:24px 0 48px}.lab-note{font-size:16px;color:var(--site-muted);margin-top:20px;max-width:650px}.lab-grid{display:grid;grid-template-columns:1fr 1fr;gap:48px 32px;padding-bottom:64px}.lab-card{min-width:0}.lab-art{display:block;position:relative;isolation:isolate;min-height:320px;overflow:hidden;padding:24px;border:1px solid var(--site-line);background:#f4f0e5;color:#191919!important}.lab-art-label{display:block;position:relative;z-index:2;font:500 12px/1.5 var(--site-mono);text-transform:uppercase}.lab-art strong{display:block;position:relative;z-index:2;font:600 clamp(28px,3.5vw,48px)/1.05 var(--site-heading-font);letter-spacing:-.04em;white-space:pre-line;width:70%;margin-top:30px}.lab-art :global(img){position:absolute;bottom:0;right:0;width:48%;height:62%;object-fit:cover;border-top:1px solid currentColor;border-left:1px solid currentColor}.lab-collage .lab-art{background:#fff04f;color:#2345ef!important}.lab-collage .lab-art strong{width:90%;transform:rotate(-3deg);font-weight:700}.lab-collage .lab-art :global(img){width:56%;height:48%;transform:rotate(4deg);right:-8px;bottom:-8px}.lab-swiss .lab-art{background:#fff;color:#121212!important}.lab-swiss .lab-art strong{width:80%}.lab-swiss-symbol{position:absolute;right:22px;bottom:-10px;color:#e32922;font:600 160px/1 var(--site-heading-font)}.lab-hackerlair .lab-art{background:#080c0a;color:#b6ff89!important}.lab-hackerlair .lab-art strong{font:500 clamp(25px,2.5vw,36px)/1.2 var(--site-mono);width:65%}.lab-hackerlair .lab-art :global(img){opacity:.6;filter:grayscale(1);width:45%;height:55%}.lab-weird-internet .lab-art{background:#245edb;color:white!important}.lab-weird-internet .lab-art strong{width:88%;font-size:clamp(30px,3.8vw,48px)}.lab-weird-internet .lab-art :global(img){width:44%;height:46%;border:5px solid #c0c0c0;box-shadow:8px 8px 0 #10194d;right:18px;bottom:20px}.lab-art:hover{outline:2px solid var(--site-accent);outline-offset:3px}.lab-card-copy{padding-top:24px}.lab-card-copy h2{font-size:32px;margin-bottom:18px}.lab-card-copy>p:not(.site-kicker){font-size:16px;color:var(--site-muted);min-height:3.3em}.lab-actions{display:flex;gap:28px;flex-wrap:wrap}.lab-outro{display:grid;grid-template-columns:1fr 1fr;gap:64px;padding-bottom:72px}.lab-outro p:not(.site-kicker){color:var(--site-muted)}
@media(max-width:680px){.lab-intro{padding:16px 0 28px}.lab-grid{grid-template-columns:1fr;gap:36px;padding-bottom:44px}.lab-art{min-height:310px;padding:22px}.lab-art strong{font-size:42px}.lab-hackerlair .lab-art strong{font-size:28px}.lab-weird-internet .lab-art strong{font-size:40px}.lab-actions{gap:20px}.lab-card-copy>p:not(.site-kicker){min-height:0}.lab-outro{grid-template-columns:1fr;gap:24px;padding-bottom:44px}.lab-card-copy{padding-top:20px}}
/* Keep the headline above the image, including when narrow cards wrap it. */
.lab-art{min-height:380px}
.lab-art strong,.lab-collage .lab-art strong,.lab-swiss .lab-art strong,.lab-hackerlair .lab-art strong,.lab-weird-internet .lab-art strong{width:100%}
.lab-art :global(img){height:42%}
.lab-collage .lab-art :global(img){height:42%}
.lab-hackerlair .lab-art :global(img){height:42%}
.lab-weird-internet .lab-art :global(img){height:40%}
@media(max-width:680px){
  .lab-art{min-height:360px}
  .lab-art strong{font-size:clamp(28px,10vw,34px)}
  .lab-hackerlair .lab-art strong{font-size:28px}
  .lab-weird-internet .lab-art strong{font-size:clamp(28px,9.2vw,34px)}
}
</style>
