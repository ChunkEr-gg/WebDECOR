---
import StudioLayout from '../layouts/StudioLayout.astro';
import Icon from '../components/Icon.astro';
import { agency } from '../data/agency';
---
<StudioLayout title="Website design services & pricing — WebDECOR" active="services" description="Strategy, website design, development, and redesign. Explore WebDECOR services and packages from $1,200.">
  <section class="site-wrap site-section services-intro">
    <p class="site-kicker">Services</p>
    <h1 class="site-heading">Website design from plan to launch.</h1>
    <p class="site-lede">From the first plan to the finished website, WebDECOR connects strategy, design, and development around your business.</p>
    <div class="service-actions"><a class="site-button" href="/start/">Discuss your project <Icon name="arrow-up-right" /></a><a class="site-button secondary" href="#pricing">See pricing <Icon name="arrow-down" /></a></div>
  </section>
  <nav class="site-wrap service-index" aria-label="Services on this page">
    {agency.services.map(service => <a href={`#${service.id}`}><span>{service.number}</span>{service.name}<Icon name="arrow-down" /></a>)}
  </nav>
  <div class="site-wrap service-list">
    {agency.services.map(service => <section class="service-detail site-rule" id={service.id} aria-labelledby={`service-${service.id}`}>
      <div><p class="site-kicker">{service.number} / {service.name}</p><h2 id={`service-${service.id}`}>{service.line}</h2><p>{service.description}</p><a class="service-link" href={`/start/?service=${service.id}`}>Discuss {service.name.toLowerCase()} <Icon name="arrow-up-right" /></a></div>
      <div class="service-deliverables"><h3>What we can work on</h3><ul>{service.deliverables.map(item => <li>{item}</li>)}</ul></div>
    </section>)}
  </div>
  <section class="site-wrap site-section site-rule" id="pricing" aria-labelledby="pricing-title">
    <p class="site-kicker">Pricing</p><h2 id="pricing-title" class="section-heading">Choose a starting point.</h2>
    <p class="section-intro">These packages help frame the conversation. Your proposal confirms the pages, features, content responsibilities, and milestones before work begins.</p>
    <div class="pricing-grid">{agency.pricing.map(plan => <article class="price-card"><p class="site-kicker">{plan.number} / Package</p><h3>{plan.name}</h3><p class="price-amount">{plan.price}</p><p>{plan.description}</p><ul>{plan.features.map(feature => <li>{feature}</li>)}</ul><a class="site-button secondary" href={`/start/?plan=${plan.id}`}>Discuss {plan.name}<Icon name="arrow-up-right" /></a></article>)}</div>
    <p class="scope-note">Page count, CMS needs, integrations, and timing depend on the agreed scope. Have a website already? A review can help identify what needs to change.</p>
  </section>
  <section class="site-wrap site-section site-rule service-close"><div><p class="site-kicker">Next step</p><h2 class="section-heading">Tell Max what you need.</h2><p>A goal, an existing site, or an early idea is enough to start the conversation.</p></div><a class="site-button" href="/start/">Start a conversation <Icon name="arrow-up-right" /></a></section>
</StudioLayout>
<style>
  .services-intro {max-width:1280px}.services-intro .site-lede {max-width:670px}.service-actions {display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}.service-index {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid var(--site-line);border-bottom:1px solid var(--site-line)}.service-index a {display:flex;align-items:center;gap:12px;min-height:72px;padding:12px 16px;text-decoration:none;font-size:14px}.service-index a:first-child {padding-left:0}.service-index span {font-family:'JetBrains Mono Variable',monospace;color:var(--site-muted);font-size:12px}.service-index svg {margin-left:auto;width:16px;flex-shrink:0}.service-detail {display:grid;grid-template-columns:1.2fr 1fr;gap:64px;padding:44px 0;scroll-margin-top:100px}.service-detail:first-child {border-top:0}.service-detail h2 {font-family:'Space Grotesk Variable',sans-serif;font-size:clamp(26px,3vw,36px);line-height:1.15;letter-spacing:-.04em;max-width:560px;margin:12px 0 16px}.service-detail p:not(.site-kicker) {color:var(--site-muted);line-height:1.6;max-width:580px}.service-link {text-decoration:underline!important;display:inline-flex;align-items:center;gap:8px;min-height:44px;margin-top:12px;text-underline-offset:5px}.service-link svg {width:16px}.service-deliverables {align-self:center;padding:24px;background:var(--site-panel)}.service-deliverables h3 {font-size:14px;font-weight:600;margin:0 0 12px}.service-deliverables ul,.price-card ul {padding-left:20px;margin:0;line-height:1.65}.service-deliverables li+li,.price-card li+li {margin-top:7px}.section-heading {font-family:'Space Grotesk Variable',sans-serif;font-size:clamp(30px,4vw,48px);line-height:1.08;letter-spacing:-.04em;margin:12px 0 20px}.section-intro {max-width:740px;color:var(--site-muted);line-height:1.65}.pricing-grid {display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px;margin-top:32px}.price-card {display:flex;flex-direction:column;padding:28px;border:1px solid var(--site-line);background:var(--site-panel)}.price-card h3 {font-family:'Space Grotesk Variable',sans-serif;font-size:24px;margin:18px 0 8px}.price-amount {font-family:'Space Grotesk Variable',sans-serif;font-size:36px;line-height:1;margin:0 0 20px}.price-card p:not(.site-kicker):not(.price-amount) {color:var(--site-muted);line-height:1.6;margin:0 0 20px}.price-card ul {margin-bottom:28px}.price-card .site-button {margin-top:auto}.scope-note {margin:24px 0 0;max-width:760px;font-size:14px;line-height:1.65;color:var(--site-muted)}.service-close {display:flex;align-items:center;justify-content:space-between;gap:32px}.service-close p:not(.site-kicker) {color:var(--site-muted);line-height:1.6;margin:0}.service-close .site-button {flex-shrink:0}#pricing {scroll-margin-top:100px}
  @media(max-width:900px){.service-index {grid-template-columns:repeat(2,minmax(0,1fr))}.service-index a {padding:12px 0}.service-detail {gap:32px}.pricing-grid {grid-template-columns:1fr}.price-card {display:grid;grid-template-columns:1fr 1fr;column-gap:28px}.price-card .site-kicker,.price-card h3,.price-amount {grid-column:1}.price-card p:not(.site-kicker):not(.price-amount) {grid-column:1}.price-card ul {grid-column:2;grid-row:2 / 5;align-self:center}.price-card .site-button {grid-column:1 / -1;justify-self:start}.service-close {align-items:flex-start;flex-direction:column}}
  @media(max-width:620px){.service-detail {grid-template-columns:1fr;gap:24px;padding:32px 0}.service-index a {font-size:12px;gap:8px}.service-index a:nth-child(odd) {padding-right:16px}.service-deliverables {padding:20px}.price-card {display:flex;padding:24px}.service-actions .site-button {flex:1;justify-content:center}}
</style>
