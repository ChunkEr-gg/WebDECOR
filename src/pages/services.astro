---
import Icon from '../components/Icon.astro';
import AgencyLayout from '../layouts/AgencyLayout.astro';
import AgencyInvitation from '../components/agency/AgencyInvitation.astro';
import AgencyPricing from '../components/agency/AgencyPricing.astro';
import CyberSectionWordmark from '../components/agency/CyberSectionWordmark.astro';
import ResponsiveStudy from '../components/agency/ResponsiveStudy.astro';
import { agency } from '../data/agency';
---
<AgencyLayout title="Services — WebDECOR" active="services">
<section class="wd-dossier wd-services-hero"><div class="ag-rail"><span><a href="/">WEBDECOR</a> / SERVICES</span><span>01 / CAPABILITIES</span></div><h1 class="wd-page-mark"><CyberSectionWordmark text="SERVICES" weight={16}/><span class="cy-sr-only">Services</span></h1><div class="wd-hero-split"><div class="wd-hero-copy"><span class="cy-label">THINK / DESIGN / BUILD / EVOLVE</span><h2>The idea.<br/>The identity.<br/>The entire experience.</h2><p>From the first question to the final interaction. We connect strategy, art direction, and development around what your website needs to achieve.</p><a href="/start/" class="ag-button">DEFINE YOUR PROJECT <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></div><figure class="wd-capability-art"><img src="/images/crt-foil.webp" alt="A folded metallic surface with dramatic black and white reflections" width="1280" height="1280"/><div class="wd-art-target" aria-hidden="true"><i></i><i></i><i></i></div><figcaption><span>RAW MATERIAL → DIGITAL EXPRESSION</span><span>WD / 01</span></figcaption></figure></div></section>
<nav class="ag-service-index" aria-label="Services on this page">{agency.services.map(service=><a href={`#${service.id}`}><span>{service.number}</span>{service.name}<b aria-hidden="true"><Icon name="arrow-down"/></b></a>)}</nav>
<section id="direction" class="wd-capability wd-direction" aria-labelledby="title-direction"><div class="wd-capability-heading"><span class="cy-label">01 / STRATEGY & DIRECTION</span><h2 id="title-direction">Give every<br/>decision a reason.</h2><p>{agency.services[0].description}</p><a href="/start/?service=direction" class="cy-text-link">START WITH DIRECTION <Icon name="arrow-up-right"/></a></div><div class="wd-direction-map"><div class="wd-map-rail"><span>EXAMPLE / CONTENT ARCHITECTURE</span><span aria-hidden="true"><Icon name="plus"/></span></div><div class="wd-map-root">YOUR BRAND<span>A clear first impression</span></div><div class="wd-map-branches"><div>DISCOVER<span>What you do</span></div><div>EXPLORE<span>Why it matters</span></div><div>CONNECT<span>The next step</span></div></div><p>Audience → content → journey → action</p></div><div class="wd-output-strip"><span class="cy-label">PROJECT ELEMENTS</span>{agency.services[0].deliverables.map(item=><span>{item}</span>)}</div></section>
<section id="design" class="wd-capability wd-design" aria-labelledby="title-design"><div class="wd-capability-heading"><span class="cy-label">02 / WEBSITE DESIGN</span><h2 id="title-design">A visual world.<br/>Made usable.</h2><p>{agency.services[1].description}</p><a href="/start/?service=design" class="cy-text-link">START WITH DESIGN <Icon name="arrow-up-right"/></a></div><div class="wd-design-specimen" aria-label="Visual system specimen"><span class="wd-micro">TYPE / IMAGE / COLOUR / GRID</span><div class="wd-specimen-type">Aa<span>01—09</span></div><div class="wd-specimen-swatches"><span>INK</span><span>PAPER</span><span>SIGNAL</span></div><div class="wd-specimen-grid" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i></div><span class="wd-micro">A CONSISTENT LANGUAGE. ROOM TO SURPRISE.</span></div><div class="wd-output-strip"><span class="cy-label">PROJECT ELEMENTS</span>{agency.services[1].deliverables.map(item=><span>{item}</span>)}</div></section>
<section id="build" class="wd-capability wd-build" aria-labelledby="title-build"><div class="wd-capability-heading"><span class="cy-label">03 / DEVELOPMENT & LAUNCH</span><h2 id="title-build">The details<br/>are the experience.</h2><p>{agency.services[2].description}</p><p class="wd-demo-prompt">Try the layout controls. Responsive design means reconsidering the composition for each screen.</p><a href="/start/?service=build" class="cy-text-link">START WITH DEVELOPMENT <Icon name="arrow-up-right"/></a></div><ResponsiveStudy id="services-proof"/><div class="wd-output-strip"><span class="cy-label">PROJECT ELEMENTS</span>{agency.services[2].deliverables.map(item=><span>{item}</span>)}</div></section>
<section id="evolve" class="wd-evolution" aria-labelledby="title-evolve"><span class="cy-label">04 / REDESIGN & EVOLUTION</span><div><h2 id="title-evolve">Your next chapter<br/>starts with a closer look.</h2><p>{agency.services[3].description}</p><a href="/start/?service=evolve" class="cy-text-link">PLAN THE NEXT CHAPTER <Icon name="arrow-up-right"/></a></div><ol>{agency.services[3].deliverables.map((item,i)=><li><span>0{i+1}</span>{item}<b aria-hidden="true"><Icon name="arrow-up-right"/></b></li>)}</ol></section>
<AgencyPricing/>
<AgencyInvitation label="NEXT / DEFINE THE SCOPE"/>
</AgencyLayout>
