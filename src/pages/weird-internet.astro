---
import Icon from '../components/Icon.astro';
import OSLayout from "../layouts/UndergroundOSLayout.astro";
import CaseStudy from '../components/CaseStudy.astro';
import Logo from '../components/underground/Logo.astro';
import Pricing from '../components/underground/Pricing.astro';
import Process from '../components/underground/Process.astro';
import FAQ from '../components/underground/FAQ.astro';
import Studies from '../components/underground/Studies.astro';
import {agency} from '../data/agency';
---
<OSLayout active="home">

<section class="u-hero" aria-labelledby="u-title" data-window="WEBDECOR / THE WEIRD INTERNET"><h1 id="u-title" class="u-wordmark"><Logo/></h1><div class="u-stage art-stage" aria-label="Arrange the CRT collage">
<div class="art-piece u-moon" data-piece="Moon print" tabindex="0" role="button" aria-label="Move the moon print" aria-describedby="art-help"><img src="/images/crt-moon.webp" alt="Torn photocopied lunar print"/></div>
<div class="art-piece u-eye" data-piece="Eye print" tabindex="0" role="button" aria-label="Move the eye print" aria-describedby="art-help"><img src="/images/crt-eye.webp" alt="Scanned halftone eye on torn paper"/></div>
<div class="art-piece u-foil" data-piece="Foil" tabindex="0" role="button" aria-label="Move the foil fragment" aria-describedby="art-help"><img src="/images/crt-foil.webp" alt="Crumpled metallic foil"/></div>
<div class="art-piece u-workstation" data-piece="Workstation" tabindex="0" role="button" aria-label="Move the complete computer workstation" aria-describedby="art-help"><div class="u-monitor"><img src="/images/crt-monitor.webp" alt="A weathered ivory vintage CRT monitor" fetchpriority="high"/><div class="u-live-screen" aria-hidden="true"><div class="u-screen-top"><span>WEBDECOR / STUDIO</span><span>WORK / ABOUT</span></div><div class="u-screen-page"><div><strong>Better<br/>websites.<br/><em>Stranger<br/>ideas.</em></strong><p>Creative direction for a more interesting internet.</p></div><img src="/images/crt-sculpture.webp" alt=""/></div><div class="u-screen-bottom">INDEPENDENT MINDS. UNEXPECTED WORLDS.</div></div></div>

<div class="u-keyboard"><img src="/images/crt-keyboard.webp" alt="Scuffed vintage ivory keyboard"/></div>
<div class="u-mouse"><img src="/images/crt-mouse.webp" alt="Cream wired desktop mouse"/></div>
</div>
<div class="art-piece u-sculpture" data-piece="Sculpture print" tabindex="0" role="button" aria-label="Move the sculpture print" aria-describedby="art-help"><img src="/images/crt-sculpture.webp" alt="Surreal classical sculpture photocopy"/></div>
</div><p class="u-handwritten">The internet<br/>should be<br/><span>weirder.</span></p><span class="u-corner-cross u-cross-one" aria-hidden="true"><Icon name="plus"/></span><span class="u-corner-cross u-cross-two" aria-hidden="true"><Icon name="plus"/></span><span class="u-hero-services">DESIGN<br/>DEVELOPMENT<br/>BRANDING<br/>CREATIVE TECH<br/>AND MORE</span><a class="u-issue-sticker" href="#u-work"><span>ISSUE 01</span><span>THE WEIRD INTERNET</span><strong>OPEN THE ARCHIVE <Icon name="plus"/></strong></a><span class="u-art-note">DESIGNED TO FEEL SOMETHING.</span><div class="u-hero-bottom"><a class="u-explore" href="#u-work">EXPLORE THE WORK <span aria-hidden="true"><Icon name="plus"/></span></a><span>INDEPENDENT MINDS. UNEXPECTED WEBSITES.</span><span class="u-coordinate" aria-hidden="true">WD_001 / NO DEFAULT SETTINGS</span></div></section>
<div class="art-controls"><span id="art-help">Drag the artwork. Focus a piece and use arrow keys.</span><div><button data-arrange-toggle aria-pressed="true">Arrange: on</button><button data-reset-layout>Reset composition</button></div><span class="art-status" role="status"></span></div><div class="u-ticker" aria-hidden="true"><div>LESS TEMPLATE. MORE TEMPERAMENT. / MADE OF IDEAS. BUILT WITH INTENTION. / LESS TEMPLATE. MORE TEMPERAMENT. / MADE OF IDEAS. BUILT WITH INTENTION. / </div></div>
<section id="u-work" class="u-work" data-window="Work / Selected transmissions"><div class="u-section-top"><span>01 / SELECTED TRANSMISSIONS</span><span>PORTFOLIO CONCEPTS / OPEN TO EXPLORE</span></div><h2>Good design.<br/><span>Strange energy.</span></h2><div class="u-projects"><button class="u-project u-project-one" data-study="u-forme" aria-label="Explore STRATA art concept"><div class="u-project-art"><img src="/images/crt-sculpture.webp" alt="Surreal photocopied marble sculpture on torn paper" width="1200" height="1500" loading="lazy"/><span class="u-project-title">STRATA_</span><span class="u-project-open">OPEN STUDY +</span><span class="u-project-number" aria-hidden="true">01</span></div><span class="u-meta">ART / DIGITAL IDENTITY / CONCEPT</span><h3>Objects with attitude.</h3><p>A digital gallery for art with an independent point of view. Scanned texture, expressive type, and unexpected details.</p></button><button class="u-project u-project-two" data-study="u-object" aria-label="Explore LUNAR STUDY editorial concept"><div class="u-project-art"><img src="/images/crt-moon.webp" alt="Lunar photography on textured torn black paper" width="1200" height="1500" loading="lazy"/><span class="u-project-title">LUNAR<br/>/ STUDY</span><span class="u-project-open">OPEN STUDY +</span><span class="u-project-number" aria-hidden="true">02</span></div><span class="u-meta">CULTURE / EDITORIAL DESIGN / CONCEPT</span><h3>A different perspective.</h3><p>An editorial culture concept that combines archival imagery, curious stories, and an intuitive path through the issue.</p></button></div><Studies/><span class="u-work-scrawl" aria-hidden="true">beautifully<br/>unreasonable.</span></section>
<section id="u-studio" class="u-studio" data-window="Studio / Human at the source"><img class="u-studio-eye" src="/images/crt-eye.webp" alt="" aria-hidden="true" loading="lazy"/><span class="u-meta">02 / THE PEOPLE BEHIND THE PIXELS</span><div class="u-studio-main"><h2>We like<br/>our ideas<br/><em>a little odd.</em></h2><div class="u-studio-copy"><p class="u-lede">The internet used to be a place to discover something unexpected. We think it still should be.</p><p>We're WebDecor. An independent creative studio making websites with personality, purpose, and a point of view.</p><p>We connect curious thinking with precise execution. A strong idea, a considered experience, and the craft to make the whole thing work.</p><a class="u-action" href="/weird-internet/studio/">MEET THE PRACTICE</a><span class="u-studio-note">HUMAN AT THE SOURCE.<br/>INDEPENDENT BY DESIGN.</span></div></div><span class="u-studio-stamp" aria-hidden="true">NO<br/>DEFAULT<br/>SETTINGS</span></section>
<section id="u-practice" class="u-practice" data-window="Services / The creative toolkit"><img class="u-practice-foil" src="/images/crt-foil.webp" alt="" aria-hidden="true" loading="lazy"/><div class="u-section-top"><span>03 / THE CREATIVE TOOLKIT</span><span>FROM FIRST INSTINCT TO FINAL PIXEL</span></div><h2>A little chaos.<br/><span>A lot of craft.</span></h2><div class="u-services">{agency.services.map((service,i)=><details open={i===0}><summary><span>{service.number}</span><h3>{service.name}</h3><span aria-hidden="true"><Icon name="plus"/></span></summary><div><p>{service.description}</p><div><ul>{service.deliverables.map(item=><li>{item}</li>)}</ul><a class="u-action" href={`/weird-internet/services/#${service.id}`}>EXPLORE THE SERVICE</a></div></div></details>)}</div></section>
<Pricing/><Process/><FAQ/><section class="u-contact" data-window="New project / Start here"><img class="u-contact-paper" src="/images/crt-moon.webp" alt="" aria-hidden="true" loading="lazy"/><span class="u-meta">YOUR NEXT CHAPTER / STARTS HERE</span><h2>LET'S MAKE<br/>SOME <em>NOISE.</em></h2><div class="u-contact-bottom"><p>An unexpected idea?<br/>A brand ready for its next expression?</p><a class="u-action" href="/weird-internet/start/">START A PROJECT</a></div><span class="u-contact-scrawl" aria-hidden="true">make it<br/>mean something.</span></section>

<CaseStudy id="u-forme" name="STRATA" category="Art & culture" image="/images/crt-sculpture.webp" alt="Surreal marble sculpture photocopy" description="An independent art and culture concept with archival textures and an expressive editorial point of view. Scanned sculpture studies, deliberate typography, and intuitive journeys bring a digital gallery to life." services={['Art direction','Digital identity','Editorial design']}/>
<CaseStudy id="u-object" name="LUNAR / STUDY" category="Editorial & culture" image="/images/crt-moon.webp" alt="A monochrome lunar paper print" description="An editorial culture concept built around lunar studies and curious stories. Archival image fragments and a considered content hierarchy invite visitors to move through an issue at their own pace." services={['Brand strategy','Web design','Astro development']}/>
<script>import '../scripts/crt-screen';import '../scripts/creative-effects';</script>

</OSLayout>
