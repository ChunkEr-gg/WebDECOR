---
import Icon from '../../components/Icon.astro';
import CyberAsterisk from '../../components/agency/CyberAsterisk.astro';
import AgencyLayout from '../../layouts/AgencyLayout.astro';
import CyberProjectWordmark from '../../components/CyberProjectWordmark.astro';
import AgencyInvitation from '../../components/agency/AgencyInvitation.astro';
import ResponsiveStudy from '../../components/agency/ResponsiveStudy.astro';
import { studies } from '../../data/agency';
export function getStaticPaths(){return studies.map(study=>({params:{slug:study.slug},props:{study}}));}
const { study }=Astro.props;
const next=studies.find(item=>item.slug!==study.slug)!;
const object=study.slug==='object';
---
<AgencyLayout title={`${study.name} — Design study — WebDECOR`} active="work" description={study.summary}>
<div class={`wd-case wd-case-${study.slug}`}>
<section data-layout-key="hero" class="ag-study-hero"><div class="ag-rail"><a href="/#work"><Icon name="arrow-left"/> DESIGN STUDIES</a><span>SELF-INITIATED CONCEPT / {study.number}</span></div><div class="ag-study-heading"><h1><CyberProjectWordmark project={study.slug}/><span class="cy-sr-only">{study.name}</span></h1><div><span class="cy-label">{study.category}</span><p>{study.summary}</p><span class="ag-study-disclaimer">Illustrative design study. Not a client commission or live business.</span></div></div><div class="wd-case-art"><figure class="ag-study-art"><img src={study.image} alt={study.alt} width={study.width} height={study.height}/><figcaption><span>WD / STUDY {study.number}</span><span>IMAGE / FORM / INTERFACE</span><span aria-hidden="true"><Icon name="plus"/></span></figcaption></figure><aside class="wd-case-art-notes"><span class="cy-label">VISUAL DNA</span><strong>{object ? 'SPACE\nBECOMES\nSTRUCTURE' : 'MATERIAL\nBECOMES\nIDENTITY'}</strong><span class="wd-micro">{object ? 'PHOTOGRAPH / LINE / SCALE' : 'SCAN / TEXTURE / TENSION'}</span><div class="wd-case-pattern" aria-hidden="true"></div></aside></div></section>
<section data-layout-key="narrative" class="ag-study-narrative"><div><span class="cy-label">THE QUESTION</span><h2>{study.challenge}</h2></div><div><article><span class="cy-label">VISUAL DIRECTION</span><p>{study.direction}</p></article><article><span class="cy-label">THE EXPERIENCE</span><p>{study.experience}</p></article><ul class="ag-study-tags">{study.deliverables.map(item=><li>{item}</li>)}</ul></div></section>
<section data-layout-key="interface" class="wd-case-interface"><div class="wd-case-interface-heading"><span class="cy-label">FROM ART DIRECTION TO INTERFACE</span><h2>{object ? 'An archive you\ncan move through.' : 'Expression meets\na clear hierarchy.'}</h2><p>{object ? 'The object and its setting lead the composition. Quiet navigation and an archival index leave space for the work.' : 'Campaign imagery gives the collection a signature. Clear object labels and a measured hierarchy make it easy to explore.'}</p><span class="wd-micro">INTERACTIVE LAYOUT STUDY / NOT A SHOP</span></div><ResponsiveStudy variant={study.slug} id={`${study.slug}-proof`}/></section>
<section data-layout-key="specification" class="wd-case-specification"><div class="wd-case-type"><span class="cy-label">01 / TYPOGRAPHIC CONTRAST</span><p>{object ? 'Object.\nSpace.\nPerspective.' : 'FORM /\nFUNCTION /\nFEELING.'}</p><span class="wd-micro">DISPLAY EXPRESSION + PRECISE UTILITY TYPE</span></div><div class="wd-case-colour"><span class="cy-label">02 / PALETTE</span><div class="wd-case-swatches"><span>01<br/>INK</span><span>02<br/>PAPER</span><span>03<br/>SIGNAL</span></div><p>Monochrome makes room for the imagery. Red marks the moments that deserve attention.</p></div><div class="wd-case-detail"><span class="cy-label">03 / MATERIAL DETAIL</span><div><img src={study.image} alt={object ? 'Close crop of the chair and its wireframe drawing' : 'Close crop of the bag texture and scan marks'} width={study.width} height={study.height} loading="lazy"/></div><span class="wd-micro">{object ? 'PHOTOGRAPHIC DEPTH × DRAWING PRECISION' : 'TACTILE SURFACE × DIGITAL STRUCTURE'}</span></div></section>
<section data-layout-key="journey" class="ag-study-system" aria-labelledby="system-title"><div><span class="cy-label">A CONCEPTUAL JOURNEY</span><h2 id="system-title">{study.headline}</h2><p>The image brings the atmosphere. The interface gives visitors a clear next step.</p></div><ol>{study.sequence.map((item,i)=><li><span>{String(i+1).padStart(2,'0')}</span><h3>{item}</h3><b aria-hidden="true">{i===2?<CyberAsterisk/>:<Icon name="arrow-right"/>}</b></li>)}</ol></section>
<a data-layout-key="next" class="ag-next-study" href={`/work/${next.slug}/`}><span class="cy-label">NEXT / DESIGN STUDY</span><span>{next.name}</span><b aria-hidden="true"><Icon name="arrow-up-right"/></b></a>
</div><AgencyInvitation heading="Your own visual world.\nA website to match."/>
</AgencyLayout>
