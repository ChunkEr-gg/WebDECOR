---
import Icon from '../../../components/Icon.astro';
import AgencyLayout from '../../../layouts/AgencyLayout.astro';
import StudyPreview from '../../../components/agency/StudyPreview.astro';
import AgencyInvitation from '../../../components/agency/AgencyInvitation.astro';
import { designStudies } from '../../../data/design-studies';
export function getStaticPaths(){return designStudies.map(study=>({params:{slug:study.slug},props:{study}}));}
const { study } = Astro.props;
const next = designStudies[(designStudies.findIndex(item=>item.slug===study.slug)+1)%designStudies.length];
---
<AgencyLayout title={study.name+' — Design study — WebDECOR'} description={study.summary} active="work">
  <article class={'wd-design-study wd-study-'+study.slug}>
    <section class="wd-study-intro">
      <div class="ag-rail"><a href="/explore/"><Icon name="arrow-left"/> THE DESIGN ARCHIVE</a><span>STUDY / {study.number} / {String(designStudies.length).padStart(2,'0')}</span></div>
      <div class="wd-study-intro-grid"><div><span class="cy-label">{study.label}</span><h1>{study.name}<span class="wd-study-title-dot">.</span></h1></div><div><p>{study.summary}</p><span class="wd-study-disclaimer">SELF-INITIATED DESIGN STUDY<br/>NOT A CLIENT COMMISSION.</span><a href={study.live} class="ag-button">ENTER THE LIVE EXPERIENCE <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></div></div>
    </section>
    <figure class="wd-study-showpiece"><StudyPreview slug={study.slug} large/><figcaption><span class="cy-label">ART DIRECTION / COMPOSITION / INTERACTION</span><button class="wd-preview-motion" data-preview-toggle aria-pressed="true"><svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M5 3v10M11 3v10" stroke="currentColor" stroke-width="1.5"/></svg><span data-preview-motion-label>PAUSE PREVIEW</span></button><a href={study.live}>EXPLORE LIVE <Icon name="arrow-up-right"/></a></figcaption></figure>
    <section class="wd-study-concept"><div><span class="cy-label">01 / THE IDEA</span><h2>{study.question}</h2></div><div><p>{study.concept}</p><div class="wd-study-applications"><span class="cy-label">A DIRECTION FOR</span>{study.applications.map(item=><span>{item}</span>)}</div></div></section>
    <section class="wd-study-language"><div class="wd-study-language-copy"><span class="cy-label">02 / THE VISUAL LANGUAGE</span><h2>A system with<br/>its own character.</h2><article><h3>Composition</h3><p>{study.layout}</p></article><article><h3>Typography</h3><p>{study.typography}</p></article></div><div class="wd-study-specimen"><div class={'wd-type-specimen wd-type-'+study.slug}><span class="wd-specimen-label">TYPE / {study.number}</span><p>{study.specimen}</p><span class="wd-specimen-label">{study.typeLabel}</span></div><div class="wd-study-palette">{study.palette.map(([name,hex])=><div><span class="wd-study-swatch" style={'background:'+hex}></span><span>{name}<small>{hex.toUpperCase()}</small></span></div>)}</div></div></section>
    <section class="wd-study-motion"><div class="wd-motion-orbit" aria-hidden="true"><svg viewBox="0 0 240 240" fill="none"><circle cx="120" cy="120" r="91"/><ellipse cx="120" cy="120" rx="45" ry="91"/><ellipse cx="120" cy="120" rx="91" ry="45"/><path d="M15 120h210M120 15v210"/><circle cx="120" cy="29" r="5" fill="currentColor"/></svg></div><div><span class="cy-label">03 / FEELING & BEHAVIOUR</span><h2>More than<br/>a static image.</h2><p>{study.motion}</p><a class="ag-button" href={study.live}>TRY THE EXPERIENCE <span aria-hidden="true"><Icon name="arrow-up-right"/></span></a></div></section>
    <a class="wd-study-next" href={'/studies/'+next.slug+'/'}><span class="cy-label">NEXT DESIGN STUDY / {next.number}</span><strong>{next.name}</strong><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M8 40 40 8M8 8h32v32" stroke="currentColor" stroke-width="1.5"/></svg></a>
  </article>
  <AgencyInvitation heading="Your own point of view.\nA website to match."/>
</AgencyLayout>
